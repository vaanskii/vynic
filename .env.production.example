# Copy to .env.production on the deployment host; use its secret manager in CI.
# Generate each Vynic-owned secret independently: openssl rand -hex 32
DATABASE_URL=postgresql://vynic:REPLACE_PASSWORD@db.example.invalid:5432/vynic?sslmode=require
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_ENCRYPTION_KEY=
PLATFORM_JWT_SECRET=
PAYMENT_INTEGRATION_MASTER_KEY=
FRONTEND_URL=https://vynic.ge
API_URL=https://vynic.ge
ALLOWED_ORIGINS=https://vynic.ge,https://admin.vynic.ge
SAAS_WEBSITE_BASE_DOMAIN=vynic.ge
SAAS_WEBSITE_PREVIEW_ORIGIN=https://preview.vynic.ge
CUSTOM_HOST=vankisi.vynic.ge
PROXY_TLS=true
IMAGE_PREFIX=registry.example.invalid/vynic
IMAGE_TAG=REPLACE_RELEASE_TAG
# Configure only after exposing/protecting native-client backend routes at this origin.
DEVICE_API_BASE_URL=

# ── Owner invitation email (off until Google credentials are configured) ─────
# No SMTP connection or OAuth refresh occurs while disabled. See docs/MAIL_SENDER.md.
MAIL_ENABLED=false
MAIL_SMTP_HOST=smtp.invalid
MAIL_SMTP_PORT=465
MAIL_AUTH_MODE=app-password
MAIL_USER=not-configured@sender.invalid
MAIL_FROM=not-configured@sender.invalid
MAIL_PUBLIC_ORIGIN=https://owner-portal.invalid
MAIL_APP_PASSWORD=replace-me.invalid
# For oauth2 mode instead of app-password; provision these later, never commit secrets.
MAIL_OAUTH_CLIENT_ID=replace-me.invalid
MAIL_OAUTH_CLIENT_SECRET=replace-me.invalid
MAIL_OAUTH_REFRESH_TOKEN=replace-me.invalid
