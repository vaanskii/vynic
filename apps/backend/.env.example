# PostgreSQL — one database, Prisma manages `pos` + `website` schemas
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vynic"

# ── POS / manager mobile ──────────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret
POS_SYNC_API_KEY=change-me-sync-key
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/firebase-adminsdk.json"

# ── Website (public reservations + customer auth) ─────────────────────────────
JWT_REFRESH_SECRET=change-me-refresh-secret
COOKIE_ENCRYPTION_KEY=change-me-32-char-cookie-key!!!
FRONTEND_URL=http://localhost:5173
API_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=

# Website SUPER_ADMIN — auto-created on server start when both are set
SUPER_ADMIN_PHONE=+995500000000
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-admin
# Legacy aliases from old server/.env also work:
# SUPER_ADMIN_PHONE= SUPER_ADMIN_EMAIL= SUPER_ADMIN_PASSWORD=

# Bank of Georgia payment gateway
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=

# ── Vynic platform control plane ──────────────────────────────────────────────
# OPTIONAL. Platform tokens are already separated from manager and customer
# tokens by a dedicated audience, an explicit principal type, and a PlatformUser
# subject lookup, so nothing breaks without this. Setting it signs platform
# tokens with their own key as well, which is worth doing in production.
# PLATFORM_JWT_SECRET=

# Create the first administrator with:
#   npm run platform-admin:create -- --email you@example.com --name "Your Name"
# The password is prompted for; PLATFORM_ADMIN_PASSWORD is only for a
# non-interactive run and should never be committed.

# ── POS device enrollment ─────────────────────────────────────────────────────
# OPTIONAL, runtime. The address POS terminals should talk to, returned to a
# terminal when it redeems an enrollment code so the operator configures one
# thing instead of two.
#
# Leave it UNSET in local development. `API_URL` above is loopback and exists so
# payment callbacks can find their way back to this process; handing that to a
# till on another machine would break the connection that had just worked. When
# this is unset the response says so, and the POS keeps the address it enrolled
# through — which is by definition an address that reaches this server.
#
# Set it in production to the canonical public API origin, e.g.
#   DEVICE_API_BASE_URL=https://api.vynic.ge
# Only the origin is used; any path, query or fragment is discarded.
# DEVICE_API_BASE_URL=

# ── Trusted reverse proxy (public website host resolution) ────────────────────
# OPTIONAL. Set to true only when a proxy in front of this process rewrites Host.
# TRUST_PROXY_HOST=false

# Server
PORT=3000
NODE_ENV=development
