# PostgreSQL — one database, Prisma manages `pos` + `website` schemas
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vynic"

# ── POS / manager mobile ──────────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret
POS_SYNC_API_KEY=change-me-sync-key
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/firebase-adminsdk.json"

# ── Website (public reservations + customer auth) ─────────────────────────────
JWT_REFRESH_SECRET=change-me-refresh-secret
COOKIE_ENCRYPTION_KEY=change-me-32-char-cookie-key!!!
FRONTEND_URL=http://localhost:5173
API_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=

# Website SUPER_ADMIN — auto-created on server start when both are set
SUPER_ADMIN_PHONE=+995500000000
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-admin
# Legacy aliases from old server/.env also work:
# SUPER_ADMIN_PHONE= SUPER_ADMIN_EMAIL= SUPER_ADMIN_PASSWORD=

# Bank of Georgia payment gateway
# 32 random bytes encoded as 64 hex characters. Store in the deployment secret manager.
PAYMENT_INTEGRATION_MASTER_KEY=
# BOG_CLIENT_ID / BOG_CLIENT_SECRET are accepted only by the explicit legacy import.

# ── Vynic platform control plane ──────────────────────────────────────────────
# OPTIONAL. Platform tokens are already separated from manager and customer
# tokens by a dedicated audience, an explicit principal type, and a PlatformUser
# subject lookup, so nothing breaks without this. Setting it signs platform
# tokens with their own key as well, which is worth doing in production.
# PLATFORM_JWT_SECRET=

# Create the first administrator with:
#   npm run platform-admin:create -- --email you@example.com --name "Your Name"
# The password is prompted for; PLATFORM_ADMIN_PASSWORD is only for a
# non-interactive run and should never be committed.

# ── POS device enrollment ─────────────────────────────────────────────────────
# OPTIONAL, runtime. The address POS terminals should talk to, returned to a
# terminal when it redeems an enrollment code so the operator configures one
# thing instead of two.
#
# Leave it UNSET in local development. `API_URL` above is loopback and exists so
# payment callbacks can find their way back to this process; handing that to a
# till on another machine would break the connection that had just worked. When
# this is unset the response says so, and the POS keeps the address it enrolled
# through — which is by definition an address that reaches this server.
#
# Set it in production to the canonical public API origin, e.g.
#   DEVICE_API_BASE_URL=https://api.vynic.ge
# Only the origin is used; any path, query or fragment is discarded.
# DEVICE_API_BASE_URL=

# ── Generic SaaS restaurant website (apps/restaurant-web) ─────────────────────
# The deployment-owned hostname suffix a published site claims. Publishing
# atomically registers `<slug>.<suffix>` as a VenueDomain, so this must be a
# name the deployment actually serves; publication fails closed while it is
# unset or malformed. Changing it later does NOT remap already published sites.
# Locally this pairs with the disposable fixture and /etc/hosts entries, or with
# the `.vynic.localhost` aliases the fixture registers.
SAAS_WEBSITE_BASE_DOMAIN=vynic.local

# OPTIONAL. Where the owner portal opens a draft preview: the origin serving
# apps/restaurant-web. Unset means the portal says preview is not configured
# rather than guessing an address. No DNS or TLS action is taken from this.
SAAS_WEBSITE_PREVIEW_ORIGIN=http://localhost:5175

# ── Trusted reverse proxy (public website host resolution) ────────────────────
# OPTIONAL. Set to true only when a proxy in front of this process rewrites Host.
# TRUST_PROXY_HOST=false

# OPTIONAL gateway mode, runtime on the native backend and request-time on the
# three Vercel projects. Leave unset for local host-preserving development.
# For Vercel -> Render, generate one independent >=32-character server-only
# value and store it in all four secret managers. Never use a VITE_ variable.
# When set, forwarded Host/IP are accepted only with the matching gateway
# header; missing credentials ignore forwarded Host and wrong ones fail closed.
# Keep TRUST_PROXY_HOST=false in this mode. See docs/VERCEL_RENDER_INTEGRATION.md.
# VYNIC_WEB_PROXY_SECRET=

# Server
PORT=3000
NODE_ENV=development

# ── Owner invitation email (off until Google credentials are configured) ─────
# No SMTP connection or OAuth refresh occurs while disabled. See docs/MAIL_SENDER.md.
MAIL_ENABLED=false
MAIL_SMTP_HOST=smtp.invalid
MAIL_SMTP_PORT=465
MAIL_AUTH_MODE=app-password
MAIL_USER=not-configured@sender.invalid
MAIL_FROM=not-configured@sender.invalid
MAIL_PUBLIC_ORIGIN=https://owner-portal.invalid
MAIL_APP_PASSWORD=replace-me.invalid
# For oauth2 mode instead of app-password; provision these later, never commit secrets.
MAIL_OAUTH_CLIENT_ID=replace-me.invalid
MAIL_OAUTH_CLIENT_SECRET=replace-me.invalid
MAIL_OAUTH_REFRESH_TOKEN=replace-me.invalid
