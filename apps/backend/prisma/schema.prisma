generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["pos", "website"]
}

// ─── POS schema (synced from Windows POS + manager mobile) ───────────────────

model Table {
  id            String   @id @default(uuid())
  venueId       String
  tableNumber   String
  floor         String
  isReserved    Boolean  @default(false)
  activeOrderId Int?
  currentBill   Float    @default(0)
  updatedAt     DateTime @updatedAt
  venue         Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@unique([venueId, tableNumber, floor], name: "tableIdentifier")
  @@index([venueId])
  @@schema("pos")
}

model Order {
  id                     String      @id @default(uuid())
  venueId                String
  posOrderId             Int
  /// Idempotency key written by the POS atomic table-close flow
  /// (docs/VYNIC_ARCHITECTURE_PLAN.md §1). Null for every order closed
  /// before that flow exists; schema-only until roadmap Task 2.
  closureId              String?     @unique
  status                 String
  totalAmount            Float
  guestCount             Int         @default(0)
  waiterName             String
  floor                  String      @default("")
  businessDate           String      @default("")
  customerName           String      @default("")
  customerPhone          String      @default("")
  pickupTime             String      @default("")
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  paymentType            String      @default("cash")
  discountAmount         Float       @default(0)
  /// Signed operator override applied to the bill total on the POS. Sent by
  /// the POS snapshot so `totalAmount` can be reconciled against the order's
  /// own item lines, discount and service fee. Zero on every order synced by
  /// a POS build that predates the field.
  manualAdjustmentAmount Float       @default(0)
  includeServiceFee      Boolean     @default(false)
  serviceFeePercent      Float       @default(10)
  items                  OrderItem[]
  venue                  Venue       @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@unique([venueId, posOrderId])
  @@index([venueId, businessDate])
  @@schema("pos")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  name       String
  quantity   Int
  price      Float
  menuItemId String?
  variantId  String?
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@schema("pos")
}

model MenuCategory {
  id                String            @id @default(uuid())
  venueId           String
  posMenuCategoryId String?
  slug              String
  nameKa            String
  nameEn            String
  sendToKitchen     Boolean           @default(true)
  sortOrder         Int               @default(0)
  updatedAt         DateTime          @updatedAt
  items             MenuItem[]
  subcategories     MenuSubcategory[]
  venue             Venue             @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@unique([venueId, slug])
  @@unique([venueId, posMenuCategoryId])
  @@index([venueId])
  @@schema("pos")
}

model MenuSubcategory {
  id                   String       @id @default(uuid())
  slug                 String
  nameKa               String
  nameEn               String
  categoryId           String
  posMenuSubcategoryId String?
  sortOrder            Int          @default(0)
  updatedAt            DateTime     @updatedAt
  items                MenuItem[]
  category             MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([slug, categoryId])
  @@unique([categoryId, posMenuSubcategoryId])
  @@schema("pos")
}

model MenuItem {
  id                 String                  @id @default(uuid())
  venueId            String
  categoryId         String?
  /// The item's own id on the POS, which owns menu identity. Ingestion matches
  /// on it first, so a rename or a move updates this row instead of creating a
  /// second product and orphaning the old one — which is what matching on
  /// `nameEn` under a parent used to do. Null for rows mirrored before the POS
  /// sent an id; the first snapshot from a POS that does adopts them in place
  /// rather than duplicating them.
  ///
  /// [id] stays the Cloud row key and the public menu-item identifier the
  /// website already hands out in pre-order payloads. This is the business
  /// identity beside it, not a replacement for it.
  posMenuItemId      String?
  nameKa             String
  nameEn             String
  price              Float
  sendToKitchen      Boolean                 @default(true)
  sortOrder          Int                     @default(0)
  updatedAt          DateTime                @updatedAt
  subcategoryId      String?
  category           MenuCategory?           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory        MenuSubcategory?        @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  variants           MenuItemVariant[]
  venue              Venue                   @relation(fields: [venueId], references: [id], onDelete: Restrict)
  consumptionRecipes MenuConsumptionRecipe[]

  @@unique([venueId, posMenuItemId])
  @@index([venueId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@schema("pos")
}

model MenuItemVariant {
  id                 String                  @id @default(uuid())
  menuItemId         String
  posMenuVariantId   String?
  size               Float
  price              Float
  menuItem           MenuItem                @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  consumptionRecipes MenuConsumptionRecipe[]

  @@unique([menuItemId, posMenuVariantId])
  @@index([menuItemId])
  @@schema("pos")
}

model Expense {
  id           String   @id @default(uuid())
  venueId      String
  /// The record's own id on the POS, which owns expense identity. Ingestion
  /// upserts on it so re-sending the same snapshot updates the row instead of
  /// adding a second one. Null only for rows written before the POS sent
  /// expense records at all.
  posExpenseId String?
  description  String
  amount       Float
  category     String
  /// POS business day (`YYYY-MM-DD`), which is not the calendar day of
  /// [createdAt] — the POS decides when its day ends.
  businessDate String   @default("")
  createdAt    DateTime @default(now())
  paymentType  String   @default("cash")
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@unique([venueId, posExpenseId])
  @@index([venueId, createdAt])
  @@index([venueId, businessDate])
  @@schema("pos")
}

/// One durable ingredient, packaged product, or other inventory identity.
/// Quantity is deliberately absent: StockMovement becomes the authoritative
/// history in Inventory Step 2. Until then clients present a derived zero.
enum StockItemClassification {
  FOOD
  BEVERAGE
  @@schema("pos")
}

model StockItem {
  id           String   @id @default(uuid())
  venueId      String
  name         String
  /// Normalized to upper case by InventoryService before persistence.
  sku          String?
  classification StockItemClassification @default(FOOD)
  baseUnit     String
  minimumStock Decimal? @db.Decimal(18, 3)
  isActive     Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  supplierProducts          SupplierProduct[]
  purchaseUnits             StockItemPurchaseUnit[]
  receivingLines            ReceivingLine[]
  movements                 StockMovement[]
  saleConsumptionComponents SaleConsumptionComponent[]
  consumptionComponents     MenuConsumptionComponent[]

  @@unique([venueId, id])
  @@unique([venueId, sku])
  @@index([venueId, isActive, name])
  @@schema("pos")
}

/// A Venue-owned supplier. Rows are disabled rather than deleted so future
/// receiving records can retain a stable reference to their counterparty.
model Supplier {
  id        String   @id @default(uuid())
  venueId   String
  name      String
  taxId     String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  supplierProducts SupplierProduct[]
  receivings Receiving[]

  @@unique([venueId, id])

  @@index([venueId, isActive, name])
  @@schema("pos")
}

/// A reusable supplier catalog. No Receiving depends on this link.
model SupplierProduct {
  venueId String
  supplierId String
  stockItemId String
  createdAt DateTime @default(now())
  supplier Supplier @relation(fields: [venueId, supplierId], references: [venueId, id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [venueId, stockItemId], references: [venueId, id], onDelete: Cascade)
  @@id([venueId, supplierId, stockItemId])
  @@index([venueId, stockItemId])
  @@schema("pos")
}

/// One item-specific purchasing package, e.g. "1 box = 24 bottle".
///
/// Count labels are deliberately never globalised: one venue's box holds 24
/// bottles of lemonade and 6 of wine. The ratio therefore belongs to the Stock
/// Item, never to the unit. Mass and volume still convert globally and need no
/// row here.
model StockItemPurchaseUnit {
  id                 String    @id @default(uuid())
  venueId            String
  stockItemId        String
  /// Purchasing label. Never equal to the Stock Item's own base unit.
  unit               String
  /// How many base units one `unit` contains. Strictly positive.
  baseUnitMultiplier Decimal   @db.Decimal(18, 6)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  venue              Venue     @relation(fields: [venueId], references: [id], onDelete: Restrict)
  stockItem          StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([stockItemId, unit])
  @@index([venueId, stockItemId])
  @@schema("pos")
}

enum ReceivingStatus {
  DRAFT
  POSTED
  CANCELLED

  @@schema("pos")
}

/// One procurement document: what arrived, from whom, on what waybill.
///
/// A DRAFT is working paper and moves no stock. POSTED freezes the document and
/// is the only state that has produced StockMovements. CANCELLED keeps both the
/// document and its original movements and adds reversals beside them, because
/// this is financial history rather than an editable balance.
model Receiving {
  id                   String          @id @default(uuid())
  venueId              String
  supplierId           String
  /// Display truth frozen at creation. A later Supplier rename must not
  /// rewrite what this document said when it was received.
  supplierNameSnapshot String
  waybillNumber        String?
  invoiceNumber        String?
  /// Document date as `YYYY-MM-DD`, the same shape as a business date.
  documentDate         String
  businessDate         String
  receivedAt           DateTime
  status               ReceivingStatus @default(DRAFT)
  notes                String?
  /// SUM(line.lineTotal), maintained exactly on every write.
  documentTotal        Decimal         @default(0) @db.Decimal(18, 2)
  createdById          String
  createdByName        String
  postedById           String?
  postedByName         String?
  postedAt             DateTime?
  cancelledById        String?
  cancelledByName      String?
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  venue                Venue           @relation(fields: [venueId], references: [id], onDelete: Restrict)
  supplier             Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines                ReceivingLine[]
  movements            StockMovement[]

  @@index([venueId, businessDate, createdAt, id])
  @@index([venueId, documentDate, createdAt, id])
  @@index([venueId, status, documentDate])
  @@index([venueId, supplierId, documentDate])
  @@index([venueId, waybillNumber])
  @@schema("pos")
}

/// A frozen purchase snapshot for one Stock Item on one Receiving.
///
/// `stockItemId` is the durable identity; `stockItemNameSnapshot` is historical
/// display context only. Both the entered figures and the base-unit figures are
/// kept, so the document still reads as it was written ("10 box") while the
/// ledger works in one unit ("240 bottle").
model ReceivingLine {
  id                    String          @id @default(uuid())
  receivingId           String
  lineSequence          Int
  stockItemId           String
  stockItemNameSnapshot String
  enteredQuantity       Decimal         @db.Decimal(18, 3)
  enteredUnit           String
  baseQuantity          Decimal         @db.Decimal(18, 3)
  baseUnit              String
  /// Purchase cost of one `enteredUnit`.
  unitPurchaseCost      Decimal         @db.Decimal(18, 4)
  /// enteredQuantity x unitPurchaseCost, rounded half-up to exact GEL.
  lineTotal             Decimal         @db.Decimal(18, 2)
  /// lineTotal / baseQuantity. Preserved for later weighted-average costing;
  /// Step 2 computes no running valuation from it.
  effectiveBaseUnitCost Decimal         @db.Decimal(18, 6)
  notes                 String?
  receiving             Receiving       @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  stockItem             StockItem       @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  movements             StockMovement[]

  @@unique([receivingId, lineSequence])
  @@index([stockItemId])
  @@schema("pos")
}

enum StockMovementType {
  RECEIVING
  RECEIVING_REVERSAL
  CONSUMPTION
  CONSUMPTION_REVERSAL

  @@schema("pos")
}

/// The authoritative quantity ledger. Current stock is SUM(quantityDeltaBase)
/// and is never stored as an editable balance.
///
/// Rows are history: a posted movement is never edited into a different number.
/// A correction is an explicit reversing movement beside the original. Later
/// steps may add WASTE / STOCKTAKE; consumption and restore use the same ledger.
model StockMovement {
  id                     String                    @id @default(uuid())
  venueId                String
  stockItemId            String
  movementType           StockMovementType
  /// Signed change in the Stock Item's own base unit.
  quantityDeltaBase      Decimal                   @db.Decimal(21, 6)
  baseUnit               String
  consumptionComponentId String?
  consumptionComponent   SaleConsumptionComponent? @relation(fields: [consumptionComponentId], references: [id], onDelete: Restrict)
  receivingId            String?
  receivingLineId        String?
  /// Set on a reversal. Unique, so a repeated cancellation cannot reverse the
  /// same movement twice even under concurrency.
  reversalOfMovementId   String?                   @unique
  businessDate           String
  effectiveAt            DateTime
  actorId                String
  actorName              String
  source                 String
  createdAt              DateTime                  @default(now())
  details                Json?
  venue                  Venue                     @relation(fields: [venueId], references: [id], onDelete: Restrict)
  stockItem              StockItem                 @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  receiving              Receiving?                @relation(fields: [receivingId], references: [id], onDelete: Restrict)
  receivingLine          ReceivingLine?            @relation(fields: [receivingLineId], references: [id], onDelete: Restrict)

  /// One movement of each kind per Receiving line, enforced by the database.
  /// Future movement kinds carry a null `receivingLineId`, which PostgreSQL
  /// treats as distinct, so they are unconstrained by this index.
  @@unique([consumptionComponentId, movementType])
  @@unique([receivingLineId, movementType])
  @@index([venueId, stockItemId, createdAt, id])
  @@index([venueId, receivingId])
  @@index([venueId, movementType, businessDate])
  @@schema("pos")
}

/// What one sold Menu Item is expected to consume from stock.
///
/// One generalized definition covers all three shapes a restaurant has: a
/// bottled product consumes 1 bottle of itself, a draft beer consumes 0.5 L of
/// a keg-filled tank, and khinkali consume four ingredients. They differ only
/// in how many components they carry, so they are deliberately not three
/// systems.
///
/// This model defines consumption; it moves no stock. Editing a recipe today
/// never rewrites what a past sale consumed — Step 4 snapshots [id] and
/// [revision] at sale time rather than joining this row back later.
model MenuConsumptionRecipe {
  id                   String   @id @default(uuid())
  venueId              String
  menuItemId           String
  /// Null when the Menu Item has no meaningful variants.
  variantId            String?
  /// `variantId ?? ''`, maintained by the service.
  ///
  /// PostgreSQL treats NULLs as distinct, so a unique index over a nullable
  /// `variantId` would happily allow two definitions for the same unvaried
  /// Menu Item. This non-null discriminator is what makes "one definition per
  /// Menu Item + variant" a database rule rather than an application hope.
  variantKey           String
  /// Display context frozen at write time; identity stays [menuItemId].
  menuItemNameSnapshot String
  variantLabelSnapshot String?
  /// How many sold units the component quantities describe. 1 is the normal
  /// per-unit definition; 100 lets a kitchen enter a khinkali batch.
  yieldQuantity        Decimal  @default(1) @db.Decimal(18, 3)
  isActive             Boolean  @default(true)
  notes                String?
  /// Bumped on every saved change, so a Step 4 consumption snapshot can name
  /// exactly which definition it used.
  revision             Int      @default(1)
  createdById          String
  createdByName        String
  updatedById          String
  updatedByName        String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  venue      Venue                      @relation(fields: [venueId], references: [id], onDelete: Restrict)
  menuItem   MenuItem                   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variant    MenuItemVariant?           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  components MenuConsumptionComponent[]

  @@unique([menuItemId, variantKey])
  @@index([venueId, isActive])
  @@index([venueId, menuItemId])
  @@schema("pos")
}

/// One Stock Item a recipe consumes.
///
/// The recipe may be entered in any unit compatible with the item's own
/// dimension ("35 g" of an item held in kg). [baseQuantity] normalizes that to
/// the item's base unit, and [baseQuantityPerUnit] divides it by the recipe
/// yield, so a later step reads one authoritative per-sale-unit number and
/// never re-derives it.
model MenuConsumptionComponent {
  id                    String   @id @default(uuid())
  venueId               String
  recipeId              String
  stockItemId           String
  /// Historical/editor context. The durable identity is [stockItemId].
  stockItemNameSnapshot String
  /// As entered, for the whole recipe yield.
  quantity              Decimal  @db.Decimal(18, 3)
  unit                  String
  /// [quantity] in the Stock Item's own base unit, for the whole yield.
  baseQuantity          Decimal  @db.Decimal(18, 3)
  baseUnit              String
  /// baseQuantity / yieldQuantity. Theoretical consumption for one sold unit;
  /// pour loss and trimming waste are a later step and are not modelled here.
  baseQuantityPerUnit   Decimal  @db.Decimal(18, 6)
  sequence              Int
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  venue     Venue                 @relation(fields: [venueId], references: [id], onDelete: Restrict)
  recipe    MenuConsumptionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stockItem StockItem             @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([recipeId, sequence])
  @@index([venueId, stockItemId])
  @@schema("pos")
}

/// Immutable POS close-time inventory intent. No historical Sale backfill.
model SaleConsumption {
  id                 String                @id @default(uuid())
  venueId            String
  posSaleId          String
  closureId          String
  orderId            Int
  businessDate       String
  closedAt           DateTime
  catalogGeneratedAt String?
  policy             String
  snapshot           Json
  reversedAt         DateTime?
  createdAt          DateTime              @default(now())
  venue              Venue                 @relation(fields: [venueId], references: [id], onDelete: Restrict)
  lines              SaleConsumptionLine[]

  @@unique([venueId, posSaleId])
  @@unique([venueId, closureId])
  @@index([venueId, businessDate, id])
  @@schema("pos")
}

model SaleConsumptionLine {
  id             String                     @id @default(uuid())
  venueId        String
  consumptionId  String
  lineSeq        Int
  menuItemId     String?
  variantId      String?
  itemName       String
  variantName    String?
  soldQuantity   Int
  status         String
  reason         String?
  recipeId       String?
  recipeRevision Int?
  venue          Venue                      @relation(fields: [venueId], references: [id], onDelete: Restrict)
  consumption    SaleConsumption            @relation(fields: [consumptionId], references: [id], onDelete: Restrict)
  components     SaleConsumptionComponent[]

  @@unique([consumptionId, lineSeq])
  @@index([venueId, status])
  @@schema("pos")
}

model SaleConsumptionComponent {
  id                    String              @id @default(uuid())
  venueId               String
  lineId                String
  stockItemId           String
  stockItemNameSnapshot String
  baseQuantityPerUnit   Decimal             @db.Decimal(18, 6)
  totalBaseQuantity     Decimal             @db.Decimal(21, 6)
  baseUnit              String
  venue                 Venue               @relation(fields: [venueId], references: [id], onDelete: Restrict)
  line                  SaleConsumptionLine @relation(fields: [lineId], references: [id], onDelete: Restrict)
  stockItem             StockItem           @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  movements             StockMovement[]

  @@unique([lineId, stockItemId])
  @@index([venueId, stockItemId])
  @@schema("pos")
}

/// Durable Cloud mirror of one genuine Sale retained by the POS.
///
/// The POS remains the operational/offline transaction authority. Monetary
/// values cross the sync boundary as fixed-scale decimal strings and are
/// persisted exactly; this model never derives historical prices from the
/// mutable Menu mirror.
model CloudSale {
  id                 String        @id @default(uuid())
  venueId            String
  posSaleId          String
  posOrderId         Int
  closureId          String?
  businessDate       String
  createdAt          DateTime
  closedAt           DateTime
  gross              Decimal       @db.Decimal(18, 2)
  subtotal           Decimal       @db.Decimal(18, 2)
  serviceFee         Decimal       @db.Decimal(18, 2)
  discount           Decimal       @db.Decimal(18, 2)
  manualAdjustment   Decimal       @db.Decimal(18, 2)
  advanceApplied     Decimal       @db.Decimal(18, 2)
  amountDueNow       Decimal       @db.Decimal(18, 2)
  collectedNow       Decimal       @db.Decimal(18, 2)
  paymentMethod      String
  customPaymentLabel String?
  isFiscal           Boolean
  isCancelled        Boolean       @default(false)
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  restoredToOrder    Boolean       @default(false)
  restoredAt         DateTime?
  restoredBy         String?
  createdBy          String
  closedById         String?
  tableNumbers       String[]
  floor              String
  sourceRevision     Int
  sourceUpdatedAt    DateTime
  syncedAt           DateTime      @updatedAt
  venue              Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  lines              SaleLine[]
  payments           SalePayment[]

  @@unique([venueId, posSaleId])
  @@unique([venueId, closureId])
  @@index([venueId, businessDate, closedAt, id])
  @@index([venueId, businessDate, paymentMethod])
  @@index([venueId, closedById, businessDate])
  @@schema("pos")
}

/// Frozen transaction-time line snapshot. menuItemId/variantId are the POS
/// business identities established by the complete Menu identity migration;
/// null means the line was manual/unlinked and is never inferred from a name.
model SaleLine {
  id          String    @id @default(uuid())
  saleId      String
  lineSeq     Int
  menuItemId  String?
  variantId   String?
  itemName    String
  variantName String?
  quantity    Int
  unitPrice   Decimal   @db.Decimal(18, 2)
  lineTotal   Decimal   @db.Decimal(18, 2)
  comment     String?
  sale        CloudSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, lineSeq])
  @@index([menuItemId])
  @@index([variantId])
  @@schema("pos")
}

/// One durable tender/advance component of a Sale.
model SalePayment {
  id     String    @id @default(uuid())
  saleId String
  method String
  amount Decimal   @db.Decimal(18, 2)
  sale   CloudSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, method])
  @@index([method])
  @@schema("pos")
}

enum SaleLedgerCompleteness {
  COMPLETE
  PARTIAL
  LEGACY_SUMMARY_ONLY

  @@schema("pos")
}

enum SaleLedgerReconciliation {
  MATCHED
  MISMATCH
  INCOMPLETE
  LEGACY_ONLY

  @@schema("pos")
}

/// Per-business-day proof of whether the per-Sale mirror is safe to use as a
/// complete financial source. A day is COMPLETE only after the POS says its
/// bounded upload has no outstanding revisions and Cloud independently
/// re-derives the same Sale count and revenue.
model SaleLedgerDay {
  id                 String                   @id @default(uuid())
  venueId            String
  businessDate       String
  completeness       SaleLedgerCompleteness
  reconciliation     SaleLedgerReconciliation
  expectedSaleCount  Int?
  expectedRevenue    Decimal?                 @db.Decimal(18, 2)
  ledgerSaleCount    Int
  ledgerRevenue      Decimal                  @db.Decimal(18, 2)
  legacyRevenue      Decimal?                 @db.Decimal(18, 2)
  declaredCompleteAt DateTime?
  lastSyncedAt       DateTime
  venue              Venue                    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@unique([venueId, businessDate])
  @@index([venueId, completeness, businessDate])
  @@schema("pos")
}

model Staff {
  id        String    @id @default(uuid())
  venueId   String
  username  String
  pinHash   String
  role      StaffRole @default(WAITER)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Restrict)

  compensations  StaffCompensation[]
  payrollPeriods PayrollPeriod[]

  @@unique([venueId, id])
  @@unique([venueId, username])
  @@index([venueId])
  @@schema("pos")
}

/// The Cloud mirror of the reservations a POS holds.
///
/// The POS remains authoritative for operational reservations; this is the copy
/// Cloud reads. It exists because the alternative was a synchronous HTTP call
/// from a backend request into a restaurant's LAN — which a hosted Vynic cannot
/// make at all, and which made a public website's table-availability page
/// depend on one restaurant PC being awake.
///
/// Reconciled wholesale from each snapshot the POS pushes: reservations the
/// snapshot no longer carries are removed, exactly as orders and tables are.
/// A snapshot that omits the field entirely changes nothing, so a POS build
/// that does not send reservations yet leaves the mirror alone rather than
/// emptying it.
model PosReservation {
  id               String    @id @default(uuid())
  venueId          String
  /// The reservation's identity on the POS, which owns it.
  posReservationId String
  customerName     String
  customerPhone    String    @default("")
  /// Legacy integer table codes, the form the website availability rules use.
  tableNumbers     Int[]
  /// Lossless floor/number references, where the POS build sends them.
  tableRefs        String[]
  reservationDate  DateTime
  reservationTime  String
  numberOfGuests   Int       @default(0)
  notes            String?
  status           String
  createdBy        String?
  isTakeAway       Boolean   @default(false)
  /// Set when this record is the POS's bookkeeping for a walk-in or takeaway
  /// order rather than a real booking.
  linkedOrderId    Int?
  posCreatedAt     DateTime?
  syncedAt         DateTime  @updatedAt
  venue            Venue     @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@unique([venueId, posReservationId])
  @@index([venueId, reservationDate])
  @@schema("pos")
}

model AuditReport {
  id           String       @id @default(uuid())
  venueId      String
  reportId     String
  posOrderId   Int
  tableNumbers String[]
  floor        String       @default("first")
  openedById   String
  openedByName String
  openedAt     DateTime
  status       String
  closedAt     DateTime?
  closedById   String?
  closedByName String?
  locked       Boolean      @default(false)
  /// Content revision of the POS record this row was written from, echoed back
  /// as the acknowledgment the POS marks synced. Null for every report ingested
  /// before incremental audit sync existed, and for any POS build that does not
  /// send one — both are treated as "revision unknown", which makes the next
  /// push rewrite the row rather than skip it.
  syncRevision String?
  /// What kind of Order this report describes: `WALK_IN`, `TAKEAWAY`,
  /// `PACKAGE` or `RESERVATION`, derived at ingestion from the report's own
  /// creation event. Query metadata only — the events remain the semantics.
  /// Null for a report opened before creation events existed, where nothing
  /// durable says what kind of Order it was; `floor` is a display string a
  /// floor-plan edit can change, so it is not used as evidence.
  orderKind    String?
  updatedAt    DateTime     @updatedAt
  events       AuditEvent[]
  venue        Venue        @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@unique([venueId, reportId])
  @@index([venueId])
  /// `posOrderId` only identifies an Order inside a Venue, so the lookup that
  /// matters — this Venue's report for this POS order — is the composite one.
  /// It is deliberately not a foreign key to `Order`: Close Day removes the
  /// operational row and the audit has to outlive it.
  @@index([venueId, posOrderId])
  @@index([status])
  @@schema("pos")
}

model AuditEvent {
  id          String      @id @default(uuid())
  reportId    String
  /// The owning Venue, copied from `report.venueId` at ingestion — which took
  /// it from the authenticated Device or Staff, never from the payload.
  ///
  /// Denormalized on purpose and deliberately not a relation: tenancy is
  /// already enforced by the report's own foreign key, and a second constraint
  /// on the hot ingest path would be checked once per event for no added
  /// authority. It exists so an event-level query can be Venue-scoped and
  /// indexed without a join. Null on rows written before this column existed.
  venueId     String?
  type        String
  itemName    String
  previousQty Int
  newQty      Int
  waiterId    String
  waiterName  String
  /// When the event happened. Temporal metadata, not the ordering key: a
  /// creation event and the lines written with it share one instant.
  eventTime   DateTime
  note        String?
  details     Json?
  /// The report-scoped ordinal the POS assigned when it appended this event.
  /// This is the timeline's order. Zero-based, and only positional for a POS
  /// build that predates POS-owned sequences.
  seq         Int         @default(0)
  report      AuditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// The timeline read: one report's events in order. Also serves lookups by
  /// `reportId` alone, so no separate single-column index is kept.
  @@index([reportId, seq])
  /// Cross-order event queries inside one Venue ("every CLOSE this month").
  @@index([venueId, type, eventTime])
  @@schema("pos")
}

model AuditEventLog {
  id         String   @id @default(uuid())
  venueId    String
  action     String
  userId     String
  /// What kind of thing this row is about: `STAFF`, `MENU_ITEM`,
  /// `MENU_CATEGORY`, `PACKAGE`, `EXPENSE`, `CLOSE_DAY`, `BACKUP`,
  /// `RESERVATION`, `ORDER`, `SALE`, `BUSINESS_DATE`, `SETTINGS`,
  /// `DEVELOPER`, `STOCK_ITEM`, `SUPPLIER`.
  ///
  /// Null for every row written before entity identity existed, and for an
  /// action the derivation cannot classify. Historical rows are not rewritten:
  /// the reader translates an entity filter into the actions that mean it, so
  /// an old row is still found by what it is.
  entityType String?
  /// Which one, inside this Venue: a staff username, a menu path, an expense
  /// id, a business date. Null when the action names no single subject.
  entityId   String?
  data       Json
  deviceType String
  createdAt  DateTime @default(now())
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  /// The default global feed: this Venue's recent activity, newest first.
  @@index([venueId, createdAt])
  @@index([createdAt])
  @@index([action])
  /// "What happened to this kind of thing here", and — with `entityId` — the
  /// history of one staff member or one menu item.
  @@index([venueId, entityType, entityId, createdAt])
  /// "Every price change here this month". `action` alone is already indexed
  /// globally; this is the Venue-scoped, time-ordered form the reader uses.
  @@index([venueId, action, createdAt])
  @@schema("pos")
}

model DailySnapshot {
  id            String   @id @default(uuid())
  venueId       String
  date          String
  totalRevenue  Float    @default(0)
  orderCount    Int      @default(0)
  avgOrderValue Float    @default(0)
  cashRevenue   Float    @default(0)
  cardRevenue   Float    @default(0)
  totalExpenses Float    @default(0)
  topItemsJson  String   @default("[]")
  updatedAt     DateTime @updatedAt
  venue         Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@unique([venueId, date])
  @@index([venueId])
  @@schema("pos")
}

/// Manager-owned counted menus. Read and written only by the Manager product,
/// so ownership follows the authenticated Manager Venue.
model QuickOrderDraft {
  id                String                @id @default(uuid())
  venueId           String
  draftId           String
  displayName       String?
  subtotal          Float
  serviceFeeAmount  Float
  total             Float
  includeServiceFee Boolean               @default(false)
  serviceFeeRate    Float                 @default(0.1)
  createdAt         DateTime              @default(now())
  createdBy         String
  updatedAt         DateTime              @updatedAt
  items             QuickOrderDraftItem[]
  venue             Venue                 @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@unique([venueId, draftId])
  @@index([venueId])
  @@schema("pos")
}

model QuickOrderDraftItem {
  id       String          @id @default(uuid())
  draftId  String
  name     String
  quantity Int
  price    Float
  comment  String?
  draft    QuickOrderDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@schema("pos")
}

enum StaffRole {
  MANAGER
  SUPERVISOR
  WAITER
  ADMIN

  @@schema("pos")
}

model Setting {
  venueId   String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@id([venueId, key])
  @@index([venueId])
  @@schema("pos")
}

enum DeviceStatus {
  ACTIVE
  DISABLED
  REVOKED

  @@schema("pos")
}

enum VenueStatus {
  ACTIVE
  DISABLED

  @@schema("pos")
}

/// Whether a registered website hostname currently resolves to its Venue.
/// A DISABLED row keeps the hostname reserved without serving it.
enum VenueDomainStatus {
  ACTIVE
  DISABLED

  @@schema("pos")
}

// ─── Platform control plane (above every restaurant tenant) ──────────────────
// A Vynic administrator is not a restaurant employee, a customer, or a machine.
// See docs/PLATFORM_CONTROL_PLANE.md.

enum PlatformUserStatus {
  ACTIVE
  DISABLED

  @@schema("pos")
}

/// What a platform principal may do.
///
/// One value today, deliberately modelled as an enum rather than a boolean:
/// finer Vynic support/operator roles are expected, and they must not arrive as
/// a second flag column. This is Vynic's own authorization vocabulary and is
/// unrelated to restaurant staff roles or to the future Venue-owned custom
/// roles, which are a different domain entirely.
enum PlatformRole {
  SUPER_ADMIN

  @@schema("pos")
}

/// A Vynic administrator.
///
/// Deliberately holds no venueId, no organizationId and no Staff relation. A
/// platform administrator sits above every tenant, so giving one a restaurant
/// membership would be inventing an ownership that does not exist and would let
/// tenant-scoped code mistake an operator for an employee.
model PlatformUser {
  id           String             @id @default(uuid())
  email        String             @unique
  displayName  String
  passwordHash String
  role         PlatformRole       @default(SUPER_ADMIN)
  status       PlatformUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  auditEvents       PlatformAuditEvent[]
  deviceEnrollments DeviceEnrollment[]

  @@schema("pos")
}

/// What a platform administrator did, and to what.
///
/// Kept apart from AuditEventLog, which records what restaurant staff did inside
/// a Venue. Writing a platform action there would claim an employee changed a
/// plan or revoked a device, which is exactly the wrong answer to "who did
/// this?".
///
/// `metadata` carries only what is safe to keep: never a password, never a
/// credential, never a hash.
model PlatformAuditEvent {
  id             String   @id @default(uuid())
  platformUserId String
  action         String
  targetType     String
  targetId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  actor PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Restrict)

  @@index([platformUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
  @@schema("pos")
}

/// Where one unit of Cloud-originated work has got to.
///
/// CLAIMED is not "done": it means an Edge holds a lease on the command. The
/// Edge reports the outcome, so only SUCCEEDED and FAILED are terminal.
enum EdgeCommandStatus {
  PENDING
  CLAIMED
  SUCCEEDED
  FAILED

  @@schema("pos")
}

enum PlanStatus {
  ACTIVE
  RETIRED

  @@schema("pos")
}

/// A Venue override either grants a feature its plan lacks or withholds one
/// its plan includes. The absence of a row is the third state — defer to the
/// plan — which is why this is an enum rather than a boolean.
enum FeatureOverrideEffect {
  ENABLED
  DISABLED

  @@schema("pos")
}

/// Which restaurant website implementation serves a Venue. This configures the
/// WEBSITE feature; it is not a feature of its own.
enum WebsiteMode {
  NONE
  SAAS
  CUSTOM

  @@schema("pos")
}

/// Customer or business account. Billing and entitlements are deliberately
/// deferred; Step 4A establishes ownership only.
model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  venues    Venue[]

  @@schema("pos")
}

/// One physical restaurant/location owned by an Organization.
model Venue {
  id                        String                     @id @default(uuid())
  organizationId            String
  name                      String
  status                    VenueStatus                @default(ACTIVE)
  timezone                  String
  currency                  String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  devices                   Device[]
  tables                    Table[]
  orders                    Order[]
  menuCategories            MenuCategory[]
  menuItems                 MenuItem[]
  expenses                  Expense[]
  compensations             StaffCompensation[]
  payrollPeriods            PayrollPeriod[]
  payrollPayments           PayrollPayment[]
  payrollAccruals           PayrollAccrual[]
  financialObligations      FinancialObligation[]
  obligationCycles          ObligationCycle[]
  obligationReserves        ObligationReserveEntry[]
  obligationPayments        ObligationPayment[]
  stockItems                StockItem[]
  suppliers                 Supplier[]
  cloudSales                CloudSale[]
  saleLedgerDays            SaleLedgerDay[]
  staff                     Staff[]
  auditReports              AuditReport[]
  posReservations           PosReservation[]
  auditEventLogs            AuditEventLog[]
  dailySnapshots            DailySnapshot[]
  settings                  Setting[]
  callbackOutbox            PosCallbackOutbox[]
  quickOrderDrafts          QuickOrderDraft[]
  notifications             ManagerNotification[]
  pushDevices               PushDevice[]
  planAssignment            VenuePlanAssignment?
  featureOverrides          VenueFeatureOverride[]
  websiteConfig             VenueWebsiteConfig?
  domains                   VenueDomain[]
  websiteTables             WebsiteTable[]
  websiteBookings           WebsiteReservation[]
  edgeCommands              EdgeCommand[]
  deviceEnrollments         DeviceEnrollment[]
  receivings                Receiving[]
  stockMovements            StockMovement[]
  purchaseUnits             StockItemPurchaseUnit[]
  saleConsumptions          SaleConsumption[]
  saleConsumptionLines      SaleConsumptionLine[]
  consumptionRecipes        MenuConsumptionRecipe[]
  saleConsumptionComponents SaleConsumptionComponent[]
  consumptionComponents     MenuConsumptionComponent[]

  @@index([organizationId])
  @@schema("pos")
}

/// One concrete Vynic POS installation authenticated for platform sync.
/// The raw credential secret is issued once; only its Argon2id verifier is
/// persisted. Its Venue is the authoritative tenant boundary for POS auth.
model Device {
  id             String       @id @default(uuid())
  venueId        String
  installationId String       @unique
  displayName    String
  platform       String
  credentialHash String
  status         DeviceStatus @default(ACTIVE)
  lastSeenAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  venue          Venue        @relation(fields: [venueId], references: [id], onDelete: Restrict)

  targetedCommands EdgeCommand[]      @relation("EdgeCommandTarget")
  claimedCommands  EdgeCommand[]      @relation("EdgeCommandClaim")
  enrollments      DeviceEnrollment[]

  @@index([status])
  @@index([venueId])
  @@schema("pos")
}

/// One invitation for a POS terminal to join a Venue.
///
/// The operator handles a short code, never the Device secret. The code is
/// bound to one Venue by the administrator who created it, so the POS never
/// supplies a venueId — the enrollment is where tenant authority comes from.
///
/// Stored like every other secret here: `codeSelector` is the public half used
/// to find the row, `codeHash` is the Argon2id verifier of the secret half. A
/// leaked database therefore yields no usable code, and there is nothing to
/// read back to an operator who lost one — issue another.
///
/// No placeholder Device is created up front. The Device is created (or, for a
/// reinstall on the same installationId, reused and rotated) at redemption, so
/// an unredeemed enrollment never leaves a terminal in the list that does not
/// exist.
///
/// Status is derived from the timestamps rather than stored, so there is no
/// second answer to drift from: cancelled, then redeemed, then expired, else
/// pending.
model DeviceEnrollment {
  id                      String    @id @default(uuid())
  venueId                 String
  /// Public half of the one-time code. Indexed lookup, never a credential.
  codeSelector            String    @unique
  /// Argon2id verifier of the code's secret half.
  codeHash                String
  displayName             String
  platform                String
  expiresAt               DateTime
  /// Failed redemptions against this code. A ceiling fails it closed.
  attemptCount            Int       @default(0)
  lastAttemptAt           DateTime?
  redeemedAt              DateTime?
  /// Which POS installation redeemed it; the same one may retry until expiry.
  redeemedInstallationId  String?
  deviceId                String?
  cancelledAt             DateTime?
  createdByPlatformUserId String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  venue     Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  device    Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdBy PlatformUser @relation(fields: [createdByPlatformUserId], references: [id], onDelete: Restrict)

  @@index([venueId, createdAt])
  @@index([expiresAt])
  @@index([deviceId])
  @@schema("pos")
}

/// One unit of work Cloud has for a restaurant's Edge installation.
///
/// The Edge pulls; Cloud never dials a restaurant's LAN. A Cloud deployment
/// cannot reach 192.168.x.x, so the only durable direction is the one the Edge
/// opens itself with its Device credential.
///
/// `deviceId` null means any Edge Device of the Venue may take the command;
/// set, it means only that Device may. Both exist because some work belongs to
/// a specific machine (its printer, its screen) and some belongs to the
/// installation, and a Venue may eventually run more than one Device.
///
/// Delivery is at-least-once: a claim is a lease, and a lease that expires
/// unacknowledged becomes available again. Execution must therefore be
/// idempotent, which is what `idempotencyKey` is for — it is unique per Venue,
/// so enqueueing the same intent twice updates one row instead of creating a
/// second command.
model EdgeCommand {
  id                String            @id @default(uuid())
  venueId           String
  deviceId          String?
  type              String
  contractVersion   Int               @default(1)
  payload           Json
  idempotencyKey    String
  status            EdgeCommandStatus @default(PENDING)
  attemptCount      Int               @default(0)
  maxAttempts       Int               @default(10)
  availableAt       DateTime          @default(now())
  claimedAt         DateTime?
  claimedByDeviceId String?
  claimExpiresAt    DateTime?
  acknowledgedAt    DateTime?
  resultCode        String?
  resultDetail      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Restrict)
  device    Device? @relation("EdgeCommandTarget", fields: [deviceId], references: [id], onDelete: Restrict)
  claimedBy Device? @relation("EdgeCommandClaim", fields: [claimedByDeviceId], references: [id], onDelete: Restrict)

  @@unique([venueId, idempotencyKey])
  @@index([venueId, status, availableAt])
  @@index([deviceId, status, availableAt])
  @@index([status, claimExpiresAt])
  @@schema("pos")
}

// ─── Product entitlements (commercial layer above tenancy) ───────────────────
// Plan is packaging, Feature is capability, and neither gates POS -> Cloud
// synchronization. See docs/PRODUCT_ENTITLEMENTS.md.

/// One capability the product can grant. Rows, not an enum, so a later
/// capability is a seed insert rather than a schema migration.
model Feature {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans     PlanFeature[]
  overrides VenueFeatureOverride[]

  @@schema("pos")
}

/// A commercial package. Carries no application logic: nothing branches on a
/// plan key, because code asks for features.
model Plan {
  id        String     @id @default(uuid())
  key       String     @unique
  name      String
  status    PlanStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  features    PlanFeature[]
  assignments VenuePlanAssignment[]

  @@schema("pos")
}

model PlanFeature {
  planId    String
  featureId String
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([planId, featureId])
  @@index([featureId])
  @@schema("pos")
}

/// Which package a Venue currently has. Deliberately not a Subscription: no
/// billing lifecycle has been decided, so none is modelled here.
model VenuePlanAssignment {
  venueId    String   @id
  planId     String
  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@schema("pos")
}

/// A per-Venue exception to its plan. Always wins over the plan default, so a
/// special agreement or a beta does not require inventing a new Plan.
model VenueFeatureOverride {
  venueId   String
  featureId String
  effect    FeatureOverrideEffect
  note      String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  venue     Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  feature   Feature               @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([venueId, featureId])
  @@index([featureId])
  @@schema("pos")
}

/// How an entitled Venue's website is served. Separate from the WEBSITE
/// entitlement, and separate from whether that website is actually deployed.
model VenueWebsiteConfig {
  venueId   String      @id
  mode      WebsiteMode @default(NONE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  venue     Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@schema("pos")
}

/// A hostname that authoritatively identifies one Venue's public website.
///
/// This is the public tenant boundary: an incoming request's host is looked up
/// here, never taken from a body, query or client-chosen header. `hostname` is
/// globally unique so a name can never resolve to two Venues, and Venue
/// deletion is restricted so ownership cannot be silently orphaned.
///
/// DNS records and TLS certificates are deployment concerns and deliberately
/// not modelled here.
model VenueDomain {
  id        String            @id @default(uuid())
  venueId   String
  hostname  String            @unique
  status    VenueDomainStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  venue     Venue             @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([venueId])
  @@schema("pos")
}

/// A Manager push/socket notification. Venue-owned because its deliveries are
/// addressed by staff username, which is only unique within a Venue.
model ManagerNotification {
  id        String   @id @default(uuid())
  venueId   String
  wsType    String
  title     String
  body      String
  envelope  Json
  createdAt DateTime @default(now())

  deliveries ManagerNotificationDelivery[]
  venue      Venue                         @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([venueId, createdAt])
  @@schema("pos")
}

model ManagerNotificationDelivery {
  id             String   @id @default(uuid())
  notificationId String
  staffUsername  String
  channel        String
  createdAt      DateTime @default(now())

  notification ManagerNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, staffUsername])
  @@index([staffUsername])
  @@schema("pos")
}

/// An FCM registration for one Manager staff member. The token is globally
/// unique because a device is, but the staff username it maps to is only
/// meaningful inside a Venue.
model PushDevice {
  id            String   @id @default(uuid())
  venueId       String
  staffUsername String
  fcmToken      String   @unique
  platform      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  venue         Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([venueId, staffUsername])
  @@schema("pos")
}

model PosCallbackOutbox {
  id            String   @id @default(uuid())
  venueId       String
  endpoint      String
  payload       Json
  posOrderId    Int?
  dedupeKey     String?
  status        String   @default("pending")
  attempts      Int      @default(0)
  maxAttempts   Int      @default(20)
  lastError     String?
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  venue         Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([venueId, status, nextAttemptAt])
  @@index([status, nextAttemptAt])
  @@index([posOrderId])
  @@index([dedupeKey])
  @@schema("pos")
}

// ─── Website schema (public bookings + customer accounts) ────────────────────

enum WebsiteUserRole {
  USER
  SUPER_ADMIN

  @@schema("website")
}

enum WebsiteReservationStatus {
  PENDING
  CONFIRMED
  FAILED
  COMPLETED

  @@schema("website")
}

model WebsiteUser {
  id        String          @id @default(uuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  email     String?         @unique
  password  String
  firstName String?
  lastName  String?
  phone     String          @unique
  role      WebsiteUserRole @default(USER)

  hashedRefreshToken String?
  reservations       WebsiteReservation[]

  @@map("users")
  @@schema("website")
}

/// Bookable tables shown on the public website. Each row maps to a POS table.
///
/// Venue-owned because it is queried directly by `websiteTableNumber`, which is
/// a customer-facing label chosen per restaurant: two Venues may both call a
/// table `table1`, so the identifier is unique only inside a Venue.
model WebsiteTable {
  id                 Int      @id @default(autoincrement())
  venueId            String
  websiteTableNumber String
  posTableNumber     String
  posFloor           String
  capacity           Int      @default(4)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  venue        Venue                     @relation(fields: [venueId], references: [id], onDelete: Restrict)
  reservations WebsiteReservationTable[]

  @@unique([venueId, websiteTableNumber])
  @@index([venueId])
  @@map("tables")
  @@schema("website")
}

/// A public-website booking. Venue-owned: it is the root the whole booking
/// subsystem hangs from, and the tenant a payment callback resolves through.
model WebsiteReservation {
  id               String                   @id @default(uuid())
  venueId          String
  userId           String?
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  date             DateTime
  timeSlot         String
  status           WebsiteReservationStatus @default(PENDING)
  totalAmount      Float?
  menuItems        String?
  paymentId        String?
  paymentStatus    String?
  notes            String?
  posReservationId String?
  numberOfGuests   Int?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  venue  Venue                     @relation(fields: [venueId], references: [id], onDelete: Restrict)
  user   WebsiteUser?              @relation(fields: [userId], references: [id])
  tables WebsiteReservationTable[]

  @@unique([venueId, posReservationId])
  @@index([venueId, date])
  @@map("reservations")
  @@schema("website")
}

model WebsiteReservationTable {
  id            Int      @id @default(autoincrement())
  reservationId String
  tableId       Int
  createdAt     DateTime @default(now())

  reservation WebsiteReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table       WebsiteTable       @relation(fields: [tableId], references: [id])

  @@unique([reservationId, tableId])
  @@map("reservation_tables")
  @@schema("website")
}


enum CompensationType {
  MONTHLY_FIXED
  DAILY_FIXED
  MANUAL

  @@schema("pos")
}

enum FinancialObligationType {
  RENT
  BANK_LOAN
  LEASE
  UTILITY
  OTHER

  @@schema("pos")
}

/// Effective-month rules. Opened periods freeze their rule; only unopened future rules may be edited.
model StaffCompensation {
  id               String           @id @default(uuid())
  venueId          String
  staffId          String
  compensationType CompensationType
  amount           Decimal          @db.Decimal(18, 2)
  effectiveFrom    String
  isActive         Boolean          @default(true)
  notes            String?
  createdAt        DateTime         @default(now())
  actorId          String
  actorName        String
  venue            Venue            @relation(fields: [venueId], references: [id], onDelete: Restrict)
  staff            Staff            @relation(fields: [venueId, staffId], references: [venueId, id], onDelete: Restrict)

  @@unique([venueId, staffId, effectiveFrom])
  @@schema("pos")
}

/// Frozen monthly rule; expected is fixed target plus explicit daily/manual accruals.
model PayrollPeriod {
  id               String           @id @default(uuid())
  venueId          String
  staffId          String
  staffName        String
  periodMonth      String
  compensationType CompensationType
  rate             Decimal          @db.Decimal(18, 2)
  targetAmount     Decimal          @db.Decimal(18, 2)
  createdAt        DateTime         @default(now())
  venue            Venue            @relation(fields: [venueId], references: [id], onDelete: Restrict)
  staff            Staff            @relation(fields: [venueId, staffId], references: [venueId, id], onDelete: Restrict)
  payments         PayrollPayment[]
  accruals         PayrollAccrual[]

  @@unique([venueId, staffId, periodMonth])
  @@unique([venueId, id])
  @@schema("pos")
}

model PayrollAccrual {
  id              String        @id
  venueId         String
  payrollPeriodId String
  payableDate     String?
  amount          Decimal       @db.Decimal(18, 2)
  /// Signed, append-only adjustments reference the unique original payable day.
  dayEntryId      String?
  worked          Boolean?
  dayEntry        PayrollAccrual? @relation("PayrollDayAdjustments", fields: [venueId, payrollPeriodId, dayEntryId], references: [venueId, payrollPeriodId, id], onDelete: Restrict, onUpdate: NoAction)
  dayAdjustments  PayrollAccrual[] @relation("PayrollDayAdjustments")
  notes           String?
  actorId         String
  actorName       String
  createdAt       DateTime      @default(now())
  venue           Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  period          PayrollPeriod @relation(fields: [venueId, payrollPeriodId], references: [venueId, id], onDelete: Restrict)

  @@unique([payrollPeriodId, payableDate])
  @@unique([venueId, payrollPeriodId, id])
  @@index([venueId, payrollPeriodId])
  @@schema("pos")
}

model PayrollPayment {
  id              String        @id
  venueId         String
  payrollPeriodId String
  amount          Decimal       @db.Decimal(18, 2)
  businessDate    String
  paymentDate     String
  notes           String?
  actorId         String
  actorName       String
  createdAt       DateTime      @default(now())
  venue           Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  period          PayrollPeriod @relation(fields: [venueId, payrollPeriodId], references: [venueId, id], onDelete: Restrict)

  @@index([venueId, businessDate])
  @@schema("pos")
}

model FinancialObligation {
  id                  String                  @id @default(uuid())
  venueId             String
  name                String
  type                FinancialObligationType
  monthlyAmount       Decimal                 @db.Decimal(18, 2)
  materializedThrough String?
  dueDay              Int
  startsOn            String
  endsOn              String?
  isActive            Boolean                 @default(true)
  notes               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  venue               Venue                   @relation(fields: [venueId], references: [id], onDelete: Restrict)
  cycles              ObligationCycle[]

  @@unique([venueId, id])
  @@index([venueId, isActive])
  @@schema("pos")
}

model ObligationCycle {
  id           String                   @id @default(uuid())
  venueId      String
  obligationId String
  name         String
  type         FinancialObligationType
  periodMonth  String
  targetAmount Decimal                  @db.Decimal(18, 2)
  dueDate      String
  createdAt    DateTime                 @default(now())
  venue        Venue                    @relation(fields: [venueId], references: [id], onDelete: Restrict)
  obligation   FinancialObligation      @relation(fields: [venueId, obligationId], references: [venueId, id], onDelete: Restrict)
  reserves     ObligationReserveEntry[]
  payments     ObligationPayment[]

  @@unique([venueId, obligationId, periodMonth])
  @@unique([venueId, id])
  @@schema("pos")
}

model ObligationReserveEntry {
  id                String          @id
  venueId           String
  obligationCycleId String
  amount            Decimal         @db.Decimal(18, 2)
  businessDate      String
  notes             String?
  actorId           String
  actorName         String
  createdAt         DateTime        @default(now())
  venue             Venue           @relation(fields: [venueId], references: [id], onDelete: Restrict)
  cycle             ObligationCycle @relation(fields: [venueId, obligationCycleId], references: [venueId, id], onDelete: Restrict)

  @@index([venueId, businessDate])
  @@schema("pos")
}

model ObligationPayment {
  id                String          @id
  venueId           String
  obligationCycleId String
  amount            Decimal         @db.Decimal(18, 2)
  reserveConsumed   Decimal         @db.Decimal(18, 2)
  businessDate      String
  paymentDate       String
  notes             String?
  actorId           String
  actorName         String
  createdAt         DateTime        @default(now())
  venue             Venue           @relation(fields: [venueId], references: [id], onDelete: Restrict)
  cycle             ObligationCycle @relation(fields: [venueId, obligationCycleId], references: [venueId, id], onDelete: Restrict)

  @@index([venueId, businessDate])
  @@schema("pos")
}
