{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vynic-installer-downloads",
  "account_id": "4347dd6103310d9273ecca7f207a0f4b",
  "main": "src/index.mjs",
  "compatibility_date": "2026-06-16",
  "workers_dev": false,
  "preview_urls": false,
