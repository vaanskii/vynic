# Must match POS_SYNC_API_KEY in apps/backend/.env
POS_SYNC_API_KEY=change-me-sync-key

# Backend URL (fully env-driven):
# Prefer platform keys for local development, and a single BACKEND_URL in production.
# BACKEND_URL=https://api.your-domain.com
BACKEND_URL_ANDROID=http://10.0.2.2:3000
BACKEND_URL_IOS=http://127.0.0.1:3000
BACKEND_URL_MACOS=http://127.0.0.1:3000
BACKEND_URL_WINDOWS=http://127.0.0.1:3000
BACKEND_URL_WEB=http://localhost:3000
BACKEND_URL_FALLBACK=http://localhost:3000

PRINTER_TYPE=network
PRINTER_KITCHEN_IP=192.168.100.10
PRINTER_RECEIPT_IP=192.168.100.11
PRINTER_PORT=9100

# POS ingest (server -> Windows). Default port 8081; optional POS_CALLBACK_HOST / POS_CONNECTION_KEY
POS_INGEST_PORT=8081
# Same-PC dev (server + POS on one machine): use loopback for callbacks
POS_CALLBACK_HOST=127.0.0.1
