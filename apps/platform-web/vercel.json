{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!(?:api|customer|platform|media|assets)(?:/|$)|.*\\.[^/]+$).*)",
      "dest": "/index.html"
    }
  ],
  "proxy": {
    "entrypoint": "proxy.ts",
    "matcher": [
      "/platform/:path*",
      "/customer/:path*",
      "/media/website-logos/:path*",
      "/((?!(?:api|customer|platform|media|assets)(?:/|$)|.*\\.[^/]+$).*)",
      "/index.html"
    ]
  }
}
