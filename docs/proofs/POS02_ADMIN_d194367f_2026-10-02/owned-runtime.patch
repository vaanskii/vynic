+
+Future<void> main() async {
+  if (!kDebugMode || !(Platform.isMacOS || Platform.isWindows)) {
+    throw UnsupportedError(
+      'POS02 preview requires macOS or Windows debug mode',
+    );
+  }
+  WidgetsFlutterBinding.ensureInitialized();
+  const endpoint = String.fromEnvironment('POS02_TEST_PRINTER_HOST');
+  final session = await Pos02PreviewSession.open(
+    transport: PreviewTransport(
+      physicalHost: endpoint.isEmpty ? null : endpoint,
+    ),
+  );
+  debugPrint(
+    'POS02 SYNTHETIC PREVIEW data=${session.directory.path}; HTTP blocked; no startup print',
+  );
+  runApp(Pos02PreviewApp(session: session));
+}
+
+class Pos02PreviewApp extends StatelessWidget {
+  const Pos02PreviewApp({super.key, required this.session});
+  final Pos02PreviewSession session;
+  @override
+  Widget build(BuildContext context) => PosLocale(
+    language: 'en',
+    child: MaterialApp(
+      title: 'Vynic POS02 — synthetic preview',
+      debugShowCheckedModeBanner: false,
+      theme: ThemeData(
+        brightness: Brightness.dark,
+        useMaterial3: true,
+        fontFamily: 'NotoSansGeorgian',
+      ),
+      home: _PreviewScreen(session: session),
+    ),
+  );
+}
+
+class _PreviewScreen extends StatefulWidget {
+  const _PreviewScreen({required this.session});
+  final Pos02PreviewSession session;
+  @override
+  State<_PreviewScreen> createState() => _PreviewScreenState();
+}
+
+class _PreviewScreenState extends State<_PreviewScreen> {
+  bool busy = false;
+  String status =
+      'Ready. No print jobs exist. Physical printers are disconnected from this preview.';
+  PrintQueueTarget target = PrintQueueTarget.kitchen;
+
+  Future<void> _send({bool physical = false}) async {
+    if (busy) return;
+    setState(() => busy = true);
+    try {
+      DateTime? approvedAt;
+      if (physical) {
+        var decided = false;
+        approvedAt = await showDialog<DateTime>(
+          context: context,
+          builder: (context) => AlertDialog(
+            title: const Text('One physical TEST page'),
+            content: Text(
+              'Target: ${widget.session.transport.physicalHost}:9100\n\nOnly continue if this exact device/model and the current safe window have been approved. This sends one labeled synthetic page. It does not test power/cable/paper interruption or confirm paper output.',
+            ),
+            actions: [
+              TextButton(
+                onPressed: () {
+                  if (decided) return;
+                  decided = true;
+                  Navigator.pop(context);
+                },
+                child: const Text('Cancel'),
+              ),
+              FilledButton(
+                onPressed: () {
+                  if (decided) return;
+                  decided = true;
+                  Navigator.pop(context, DateTime.now());
+                },
+                child: const Text('Approved now — one TEST page'),
+              ),
+            ],
+          ),
+        );
+        if (approvedAt == null || !mounted) return;
+      }
+      setState(() {
+        status = 'Rendering and admitting one labeled synthetic job…';
+      });
+      final job = await widget.session.sendSample(
+        target,
+        physical: physical,
+        currentWindowApproved: physical,
+        approvedAt: approvedAt,
+      );
+      if (mounted)
+        setState(
+          () => status =
+              '${physical ? 'Physical TCP attempt' : 'SIMULATED transport'}: ${printJobStateLabel(context, job.state)}\nJob: ${job.id}\nPhysical paper is not confirmed.',
+        );
+    } catch (error) {
+      if (mounted) setState(() => status = 'Test action failed: $error');
+    } finally {
+      if (mounted) setState(() => busy = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+    appBar: AppBar(title: const Text('POS02 • SYNTHETIC TEST PREVIEW')),
+    body: SingleChildScrollView(
+      padding: const EdgeInsets.all(24),
+      child: Center(
+        child: ConstrainedBox(
+          constraints: const BoxConstraints(maxWidth: 800),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text(
+                'Fresh test data. HTTP blocked. Fake printer by default.',
+                style: Theme.of(context).textTheme.titleLarge,
+              ),
+              const SizedBox(height: 12),
+              const Text(
+                'This is the POS02 print/journal preparation harness. Production data, enrollment, sync and updater startup are not opened. Reconciliation stays read-only until the owner policy is chosen.',
+              ),
+              const SizedBox(height: 12),
+              SelectableText(
+                'Synthetic data directory:\n${widget.session.directory.path}',
+              ),
+              const SizedBox(height: 24),
+              DropdownButton<PrintQueueTarget>(
+                value: target,
+                onChanged: busy
+                    ? null
+                    : (value) => setState(() => target = value!),
+                items: const [
+                  DropdownMenuItem(
+                    value: PrintQueueTarget.kitchen,
+                    child: Text('სამზარეულო / Kitchen sample'),
+                  ),
+                  DropdownMenuItem(
+                    value: PrintQueueTarget.receipt,
+                    child: Text('ქვითარი / Receipt sample'),
+                  ),
+                ],
+              ),
+              DropdownButton<PreviewOutcome>(
+                value: widget.session.transport.outcome,
+                onChanged: busy
+                    ? null
+                    : (value) => setState(
+                        () => widget.session.transport.outcome = value!,
+                      ),
+                items: const [
+                  DropdownMenuItem(
+                    value: PreviewOutcome.sent,
+                    child: Text('Fake TCP sent'),
+                  ),
+                  DropdownMenuItem(
+                    value: PreviewOutcome.connectionFailure,
+                    child: Text('Fake no-byte connection failure'),
+                  ),
+                  DropdownMenuItem(
+                    value: PreviewOutcome.partialWrite,
+                    child: Text('Fake partial-write uncertainty'),
+                  ),
+                ],
+              ),
+              const SizedBox(height: 12),
+              Wrap(
+                spacing: 12,
+                runSpacing: 12,
+                children: [
+                  FilledButton.icon(
+                    key: const ValueKey('preview-simulate'),
+                    onPressed: busy ? null : () => _send(),
+                    icon: const Icon(Icons.science_outlined),
+                    label: const Text('Simulate one TEST job'),
+                  ),
+                  OutlinedButton(
+                    key: const ValueKey('preview-physical'),
+                    onPressed:
+                        busy || widget.session.transport.physicalHost == null
+                        ? null
+                        : () => _send(physical: true),
+                    child: const Text('Physical TEST page — explicit opt-in'),
+                  ),
+                ],
+              ),
+              const SizedBox(height: 12),
+              Text(
+                widget.session.transport.physicalHost == null
+                    ? 'No physical endpoint is configured. No live printer can be reached.'
+                    : 'Opt-in endpoint ${widget.session.transport.physicalHost}:9100 requires current approval for each single TEST job.',
+              ),
+              const SizedBox(height: 24),
+              SelectableText(status),
+              const SizedBox(height: 16),
+              const PrintJobsNotice(),
+              const SizedBox(height: 12),
+              const Text(
+                'TEST / DO NOT PREPARE. Simulated “sent” proves no paper output. Close and relaunch to get another fresh isolated directory.',
+              ),
+            ],
+          ),
+        ),
+      ),
+    ),
+  );
+}
diff --git a/apps/operations/tool/prove_pos02_recovery.py b/apps/operations/tool/prove_pos02_recovery.py
new file mode 100644
index 0000000000000000000000000000000000000000..a2892ffcb5e795c2073450eb39856434fd6aa135
--- /dev/null
+++ b/apps/operations/tool/prove_pos02_recovery.py
@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+"""SIGKILL/restart every print journal I/O and transport boundary; owned synthetic data only."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import shutil
+import signal
+import subprocess
+import tempfile
+import time
+
+
+def require_descendant(native_pid, runner_pid):
+    current = native_pid
+    for _ in range(20):
+        if current == runner_pid:
+            return
+        value = subprocess.check_output(['ps', '-o', 'ppid=', '-p', str(current)], text=True).strip()
+        if not value or int(value) <= 1:
+            break
+        current = int(value)
+    raise RuntimeError('Refusing to signal a process not created by this proof')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--flutter', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--checkpoint', type=int, help='Optional one boundary for debugging')
+    parser.add_argument('--scenario', choices=['send','uncertain','reprint','confirm','remotecreate','localconfirm'])
+    args = parser.parse_args()
+    project = Path(__file__).resolve().parents[1]
+    output = args.output.resolve()
+    output.parent.mkdir(parents=True, exist_ok=True)
+    root = Path(tempfile.mkdtemp(prefix='vynic_pos02_process_', dir=None))
+    command = [str(args.flutter.resolve()), '--suppress-analytics', 'test', '--no-pub', '--reporter', 'expanded', 'test/live/pos02_process_recovery_test.dart']
+    source_files = sorted((project / 'lib').rglob('*.dart')) + [project / 'test/support/pos02_fixture.dart', project / 'test/support/menu01_fixture.dart', project / 'test/flutter_test_config.dart', project / 'test/live/pos02_process_recovery_test.dart', Path(__file__).resolve()]
+    source_hashes = {str(path.relative_to(project)): hashlib.sha256(path.read_bytes()).hexdigest() for path in source_files}
+    base_env = dict(os.environ, FLUTTER_SUPPRESS_ANALYTICS='true')
+    proofs = []
+    active = None
+    def run(stage, path, case):
+        log_path = output.with_suffix(f'.{case}-{stage}.log')
+        env = dict(base_env, POS02_PROCESS_DIRECTORY=str(path), POS02_PROCESS_STAGE=stage, POS02_SCENARIO=scenario)
+        with log_path.open('w') as log:
+            result = subprocess.run(command, cwd=project, env=env, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, timeout=60)
+        if result.returncode:
+            raise RuntimeError(f'{case} {stage} failed; inspect {log_path}')
+        return hashlib.sha256(log_path.read_bytes()).hexdigest()
+    try:
+        capture_hashes = {}
+        available = 0
+        for scenario in ([args.scenario] if args.scenario else ['send','uncertain','reprint','confirm','remotecreate','localconfirm']):
+            capture = root / f'{scenario}-capture'; capture.mkdir()
+            capture_hash = run('boundaries', capture, f'{scenario}-boundaries')
+            trace = json.loads((capture / 'boundaries.json').read_text())['trace']
+            targets = [args.checkpoint] if args.checkpoint else list(range(1, len(trace) + 1))
+            for target in targets:
+                case = f'{scenario}-{target:03d}'
+                path = root / case; path.mkdir()
+                log_path = output.with_suffix(f'.{case}-writer.log')
+                env = dict(base_env, POS02_PROCESS_DIRECTORY=str(path), POS02_PROCESS_STAGE='writer', POS02_CHECKPOINT=str(target), POS02_SCENARIO=scenario)
+                with log_path.open('w') as log:
+                    active = subprocess.Popen(command, cwd=project, env=env, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
+                    deadline = time.monotonic() + 60
+                    ready_path = path / 'ready.json'
+                    while not ready_path.exists():
+                        if active.poll() is not None:
+                            raise RuntimeError(f'{case} writer exited before signal; inspect {log_path}')
+                        if time.monotonic() >= deadline:
+                            raise TimeoutError(f'{case} writer did not reach its boundary')
+                        time.sleep(0.02)
+                    ready = json.loads(ready_path.read_text())
+                    if ready['point'] != trace[target - 1] or not ready['httpBlocked'] or ready['boxesClosed']:
+                        raise RuntimeError(f'{case} boundary mismatch')
+                    native_pid = int(ready['pid'])
+                    require_descendant(native_pid, active.pid)
+                    os.kill(native_pid, signal.SIGKILL)
+                    writer_exit = active.wait(timeout=30)
+                    if writer_exit == 0:
+                        raise RuntimeError('Killed writer falsely reported success')
+                    active = None
+                reader_hash = run('reader', path, case)
+                result = json.loads((path / 'result.json').read_text())
+                if result['readerPid'] == native_pid or result['status'] != 'PASS':
+                    raise RuntimeError('Restart verification did not use a different native process')
+                proofs.append({'scenario':scenario,'checkpoint': target, 'point': trace[target - 1], 'signal': 'SIGKILL',
+                    'writerExit': writer_exit, 'beforeKill': ready, 'restart': result,
+                    'writerLogSha256': hashlib.sha256(log_path.read_bytes()).hexdigest(), 'readerLogSha256': reader_hash})
+                output.write_text(json.dumps({'status': 'IN_PROGRESS', 'completed': proofs, 'total': len(targets)}, indent=2) + '\n')
+                print(f'{case}/{len(trace)} PASS {trace[target - 1]}', flush=True)
+            capture_hashes[scenario] = capture_hash
+            available += len(trace)
+        if source_hashes != {str(path.relative_to(project)): hashlib.sha256(path.read_bytes()).hexdigest() for path in source_files}:
+            raise RuntimeError('Source changed during native proof; repeat on final source')
+        result = {'status': 'PASS', 'platform': platform.platform(), 'command': command, 'sourceSha256': source_hashes,
+            'checkpointCount': len(proofs), 'availableCheckpointCount': available,
+            'allRealHttpBlocked': True, 'syntheticOnly': True, 'temporaryDirectoryRemoved': True,
+            'captureLogSha256': capture_hashes, 'checkpoints': proofs}
+        output.write_text(json.dumps(result, indent=2) + '\n')
+        print(f'PASS {len(proofs)} SIGKILL/different-process restart checkpoints', flush=True)
+    finally:
+        if active is not None and active.poll() is None:
+            # Only our runner; never find/kill an unrelated application.
+            active.terminate(); active.wait(timeout=10)
+        shutil.rmtree(root)
+
+
+if __name__ == '__main__':
+    main()
