+
+  test(
+    'addition persists across settings close/reopen and primary save',
+    () async {
+      await LocalPrinterCatalog.add(' ბარი ', ' 10.0.0.7 ');
+      final id = LocalPrinterCatalog.read().single['id'];
+      await DatabaseService.savePrinterConfiguration(
+        kitchenIp: '10.0.0.8',
