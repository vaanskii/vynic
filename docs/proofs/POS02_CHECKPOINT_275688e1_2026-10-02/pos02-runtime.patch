@@ -0,0 +1,40 @@
+import 'package:vynic/core/database/local_data_admission.dart';
+import 'package:vynic/core/database/repositories/order_table_mutation_repository.dart';
+import 'package:vynic/core/models/order.dart';
+import 'package:vynic/core/services/database_service.dart';
+import 'package:vynic/core/services/printing/printer_service.dart';
+
+/// Admit the frozen initial ticket before committing confirmation. The worker
+/// starts outside this owner and additionally checks the saved Order status.
+/// A crash at either write leaves a pending Order or a durable held ticket.
+abstract final class OrderConfirmationPrint {
+  static Future<bool> confirm({
+    required Order order,
+    required List<String> lines,
+    required String tableLabel,
+    void Function(bool)? onComplete,
+  }) {
+    final frozen = List<String>.of(lines);
+    return LocalDataAdmission.mutate(() async {
+      OrderTableMutationRepository.requireFresh(order);
+      if (frozen.isNotEmpty) {
+        final accepted = await PrinterService.printKitchenCheckInBackground(
+          initialOrderUuid: order.orderUuid,
+          requiresConfirmedOrderUuid: order.orderUuid,
+          items: frozen,
+          tableNumber: tableLabel,
+          orderNumber: order.orderId.toString(),
+          waiterName: order.createdBy,
+          createdAt: order.createdAt,
+          onComplete: onComplete,
+        );
+        if (!accepted) return false;
+      }
+      await DatabaseService.updateOrderStatus(
+        orderId: order.orderId,
+        status: 'confirmed',
+      );
+      return true;
+    });
+  }
+}
diff --git a/apps/operations/lib/core/services/printing/print_job.dart b/apps/operations/lib/core/services/printing/print_job.dart
new file mode 100644
index 0000000..a558c27
--- /dev/null
+++ b/apps/operations/lib/core/services/printing/print_job.dart
@@ -0,0 +1,233 @@
+import 'dart:convert';
+import 'package:crypto/crypto.dart';
+
+enum PrintQueueTarget { kitchen, receipt }
+
+/// `sent` means TCP accepted the bytes, never that paper emerged. Only a
+/// deliberate operator observation can move an attempt to `confirmed`.
+enum PrintJobState {
+  queued,
+  reprint,
+  sending,
+  sent,
+  failed,
+  uncertain,
+  confirmed,
+}
+
+enum PrintTransmissionState { sent, notSent, uncertain }
+
+class PrintTransmissionResult {
+  const PrintTransmissionResult(this.state, this.detail);
+  final PrintTransmissionState state;
+  final String detail;
+  bool get sent => state == PrintTransmissionState.sent;
+}
+
+class PrintJob {
+  PrintJob._(this._body);
+  final Map<String, dynamic> _body;
+  static const protocol = 1;
+  static const maxPayloadBytes = 8 * 1024 * 1024;
+
+  String get id => _body['id'] as String;
+  PrintQueueTarget get target =>
+      PrintQueueTarget.values.byName(_body['target']);
+  String get host => _body['host'] as String;
+  int get port => _body['port'] as int;
+  String get label => _body['label'] as String;
+  String? get requiresConfirmedOrderUuid =>
+      _body['requiresConfirmedOrderUuid'] as String?;
+  String? get copyOf => _body['copyOf'] as String?;
+  String? get venueId => _body['venueId'] as String?;
+  String get createdAt => _body['createdAt'] as String;
+  List<Map<String, dynamic>> get attempts => [
+    for (final attempt in _body['attempts'])
+      Map<String, dynamic>.from(attempt as Map),
+  ];
+  Map<String, dynamic> get latest => attempts.last;
+  String get attemptId => latest['id'] as String;
+  PrintJobState get state => PrintJobState.values.byName(latest['state']);
+  bool get ready =>
+      state == PrintJobState.queued || state == PrintJobState.reprint;
+  bool get needsAttention =>
+      state == PrintJobState.uncertain || state == PrintJobState.failed;
+  String? get detail => latest['detail'] as String?;
+  List<Map<String, dynamic>> get audit => [
+    for (final event in _body['audit']) Map<String, dynamic>.from(event as Map),
+  ];
+
+  Map<String, dynamic> toMap() =>
+      jsonDecode(jsonEncode(_body)) as Map<String, dynamic>;
+
+  /// Printed identifiers and copy labels survive any later Order/Menu edits.
+  List<int> get transmissionBytes => [
+    0x1b,
+    0x40,
+    ...ascii.encode(
+      attempts.length == 1 && copyOf == null
+          ? 'JOB $id\n'
+          : '*** REPRINT COPY ${attempts.length - (copyOf == null ? 1 : 0)} ***\nJOB $id\nOriginal may already have printed.\n',
+    ),
+    ...base64Decode(_body['payload'] as String),
+  ];
+
+  factory PrintJob.create({
+    required String id,
+    required PrintQueueTarget target,
+    required String host,
+    required int port,
+    required String label,
+    required List<int> bytes,
+    String? venueId,
+    String? copyOf,
+    String? requiresConfirmedOrderUuid,
+    String? copyActorId,
+    String? copyReason,
+  }) {
+    final now = DateTime.now().toUtc().toIso8601String();
+    return PrintJob.decode({
+      'protocol': protocol,
+      'id': id,
+      'target': target.name,
+      'host': host,
+      'port': port,
+      'label': label,
+      'venueId': venueId,
+      if (copyOf != null) 'copyOf': copyOf,
+      if (requiresConfirmedOrderUuid != null)
+        'requiresConfirmedOrderUuid': requiresConfirmedOrderUuid,
+      'createdAt': now,
+      'payload': base64Encode(bytes),
+      'payloadSha256': sha256.convert(bytes).toString(),
+      'attempts': [
+        {'id': id, 'state': 'queued', 'queuedAt': now},
+      ],
+      'audit': [
+        {
+          'action': 'queued',
+          'at': now,
+          'attemptId': id,
+          if (copyOf != null) 'copyOf': copyOf,
+          if (copyActorId != null) 'actorId': copyActorId,
+          if (copyReason != null) 'reason': copyReason,
+        },
+      ],
+    });
+  }
+
+  /// Strictly validate before startup dispatch or any backup replacement.
+  factory PrintJob.decode(dynamic raw) {
+    try {
+      final b = jsonDecode(jsonEncode(raw)) as Map<String, dynamic>;
+      bool text(dynamic v, int max) =>
+          v is String && v.trim().isNotEmpty && v.length <= max;
+      void require(bool condition) {
+        if (!condition)
+          throw const FormatException('Invalid durable print job');
+      }
+
+      require(b['protocol'] == protocol && text(b['id'], 120));
+      require(RegExp(r'^[a-zA-Z0-9_-]+$').hasMatch(b['id']));
+      require(PrintQueueTarget.values.any((v) => v.name == b['target']));
+      require(
+        text(b['host'], 255) &&
+            b['port'] is int &&
+            b['port'] >= 1 &&
+            b['port'] <= 65535,
+      );
+      require(text(b['label'], 300));
+      require(b['venueId'] == null || text(b['venueId'], 120));
+      require(b['copyOf'] == null || text(b['copyOf'], 300));
+      require(
+        b['requiresConfirmedOrderUuid'] == null ||
+            text(b['requiresConfirmedOrderUuid'], 120),
+      );
+      DateTime.parse(b['createdAt'] as String);
+      final bytes = base64Decode(b['payload'] as String);
+      require(bytes.isNotEmpty && bytes.length <= maxPayloadBytes);
+      require(b['payloadSha256'] == sha256.convert(bytes).toString());
+      require(b['attempts'] is List && (b['attempts'] as List).isNotEmpty);
+      final ids = <String>{};
+      for (final a in b['attempts']) {
+        require(a is Map && text(a['id'], 120));
+        require(
+          ids.add(a['id']) &&
+              PrintJobState.values.any((v) => v.name == a['state']),
+        );
+        DateTime.parse(a['queuedAt'] as String);
+        require(a['detail'] == null || a['detail'] is String);
+        if (ids.length > 1) {
+          require(text(a['actorId'], 120) && text(a['reason'], 500));
+          require(a['state'] != 'queued');
+        } else {
+          require(a['id'] == b['id'] && a['state'] != 'reprint');
+        }
+      }
+      require(b['audit'] is List && (b['audit'] as List).isNotEmpty);
+      final states = <String, String>{};
+      final actionIds = <String>{};
+      String? latestId;
+      for (final e in b['audit']) {
+        require(
+          e is Map && text(e['action'], 40) && ids.contains(e['attemptId']),
+        );
+        DateTime.parse(e['at'] as String);
+        final id = e['attemptId'] as String;
+        final action = e['action'] as String;
+        final prior = states[id];
+        final operator =
+            action == 'confirmed' ||
+            action == 'reprint' ||
+            action == 'queued' && prior != null ||
+            e['copyOf'] != null;
+        if (operator) {
+          require(text(e['actorId'], 120) && text(e['reason'], 500));
+          if (e['actionId'] != null)
+            require(text(e['actionId'], 120) && actionIds.add(e['actionId']));
+        }
+        if (prior == null) {
+          require(id == (b['attempts'] as List)[states.length]['id']);
+          require(states.isEmpty ? action == 'queued' : action == 'reprint');
+          if (latestId != null)
+            require(
+              ['sent', 'uncertain', 'confirmed'].contains(states[latestId]),
+            );
+          final attempt = (b['attempts'] as List)[states.length];
+          if (states.isNotEmpty) {
+            require(
+              attempt['actorId'] == e['actorId'] &&
+                  attempt['reason'] == e['reason'],
+            );
+            require(actionIds.add(id));
+          } else if (b['copyOf'] != null) {
+            require(e['copyOf'] == b['copyOf']);
+          } else {
+            require(e['copyOf'] == null);
+          }
+          latestId = id;
+        } else {
+          require(id == latestId);
+          final allowed = switch (prior) {
+            'queued' || 'reprint' => ['sending', 'uncertain'],
+            'sending' => ['sent', 'failed', 'uncertain'],
+            'sent' || 'uncertain' => ['confirmed'],
+            'failed' => [id == b['id'] ? 'queued' : 'reprint'],
+            _ => <String>[],
+          };
+          require(allowed.contains(action));
+          if (action == 'confirmed' || prior == 'failed')
+            require(e['actionId'] != null);
+        }
+        states[id] = action;
+      }
+      require(states.length == (b['attempts'] as List).length);
+      for (final a in b['attempts']) require(states[a['id']] == a['state']);
+      return PrintJob._(b);
+    } on FormatException {
+      rethrow;
+    } catch (_) {
+      throw const FormatException('Invalid durable print job');
+    }
+  }
+}
diff --git a/apps/operations/lib/core/services/printing/print_reconciliation.dart b/apps/operations/lib/core/services/printing/print_reconciliation.dart
new file mode 100644
index 0000000..0d71452
--- /dev/null
+++ b/apps/operations/lib/core/services/printing/print_reconciliation.dart
@@ -0,0 +1,163 @@
+import 'package:vynic/core/database/local_data_admission.dart';
+import 'package:vynic/core/database/repositories/print_job_repository.dart';
+import 'package:vynic/core/models/user.dart';
+import 'package:vynic/core/services/auth/pos_session.dart';
+import 'package:vynic/core/services/database_service.dart';
+import 'package:vynic/core/services/edge/edge_device_credential_store.dart';
+import 'print_job.dart';
+import 'print_queue.dart';
+
+enum PrintReconciliationPolicy { unconfigured, administrators, printingStaff }
+
+/// The owner must choose the operator policy. Until then the journal is
+/// readable, but no action can manufacture a paper confirmation/reprint.
+class PrintReconciliation {
+  PrintReconciliation._();
+  static PrintReconciliationPolicy policy =
+      PrintReconciliationPolicy.unconfigured;
+
+  static bool get allowed {
+    final user = PosSession.user;
+    if (user == null || policy == PrintReconciliationPolicy.unconfigured)
+      return false;
+    return policy == PrintReconciliationPolicy.printingStaff || user.isManager;
+  }
+
+  static User _actor() {
+    final session = PosSession.user;
+    if (session == null)
+      throw StateError('Sign in before reconciling print jobs');
+    final users = DatabaseService.getAllUsers().where(
+      (u) => u.username == session.username,
+    );
+    if (users.length != 1)
+      throw StateError('Current staff identity is unavailable');
+    final user = users.single;
+    if (policy == PrintReconciliationPolicy.unconfigured ||
+        policy == PrintReconciliationPolicy.administrators && !user.isManager)
+      throw StateError('This staff member cannot reconcile print jobs');
+    return user;
+  }
+
+  static void _reason(String reason) {
+    if (reason.trim().length < 3 || reason.length > 500)
+      throw ArgumentError('Record a reason between 3 and 500 characters');
+  }
+
+  static User authorizeCopy(String reason) {
+    _reason(reason);
+    return _actor();
+  }
+
+  static PrintJob _job(String id) {
+    final job = PrintJobRepository.read(id);
+    if (job == null) throw StateError('Print job not found');
+    if (job.venueId != EdgeDeviceCredentialStore.venueId)
+      throw StateError(
+        'Enroll this terminal in the backup Venue before reconciling its print jobs',
+      );
+    return job;
+  }
+
+  static Future<void> confirm(
+    PrintJob expected,
+    String reason,
+    String requestId,
+  ) => LocalDataAdmission.mutate(() async {
+    final actor = _actor();
+    _reason(reason);
+    final job = _job(expected.id);
+    if (_already(job, requestId, actor.username, reason, 'confirmed')) return;
+    if (job.attemptId != expected.attemptId ||
+        job.state != expected.state ||
+        !(job.state == PrintJobState.sent ||
+            job.state == PrintJobState.uncertain))
+      throw StateError(
+        'This attempt is not awaiting paper reconciliation; refresh the list',
+      );
+    await PrintJobRepository.transition(
+      job.id,
+      job.attemptId,
+      job.state,
+      PrintJobState.confirmed,
+      actorId: actor.username,
+      reason: reason.trim(),
+      actionId: requestId,
+      detail: 'Paper output checked by an operator',
+    );
+  });
+
+  static Future<void> reprint(
+    PrintJob expected,
+    String reason,
+    String requestId,
+  ) => LocalDataAdmission.mutate(() async {
+    final actor = _actor();
+    _reason(reason);
+    final job = _job(expected.id);
+    if (!_already(job, requestId, actor.username, reason, 'reprint')) {
+      if (job.state != expected.state)
+        throw StateError('Print status changed; refresh the list');
+      await PrintJobRepository.reprint(
+        job.id,
+        expected.attemptId,
+        requestId,
+        actor.username,
+        reason.trim(),
+      );
+    }
+    PrintQueue.wake();
+  });
+
+  static Future<void> retryNotSent(
+    PrintJob expected,
+    String reason,
+    String requestId,
+  ) => LocalDataAdmission.mutate(() async {
+    final actor = _actor();
+    _reason(reason);
+    final job = _job(expected.id);
+    final next = job.attempts.length == 1
+        ? PrintJobState.queued
+        : PrintJobState.reprint;
+    if (!_already(job, requestId, actor.username, reason, next.name)) {
+      if (job.attemptId != expected.attemptId ||
+          job.state != PrintJobState.failed)
+        throw StateError('Only an attempt that wrote no bytes can be retried');
+      await PrintJobRepository.transition(
+        job.id,
+        job.attemptId,
+        PrintJobState.failed,
+        next,
+        actorId: actor.username,
+        reason: reason.trim(),
+        actionId: requestId,
+        detail: 'Operator requested retry after no-byte connection failure',
+      );
+    }
+    PrintQueue.wake();
+  });
+
+  static bool _already(
+    PrintJob job,
+    String id,
+    String actor,
+    String reason,
+    String action,
+  ) {
+    final events = job.audit.where(
+      (e) =>
+          e['actionId'] == id ||
+          e['action'] == 'reprint' &&
+              e['attemptId'] == id &&
+              e['actionId'] == null,
+    );
+    if (events.isEmpty) return false;
+    final event = events.single;
+    if (event['actorId'] != actor ||
+        event['reason'] != reason.trim() ||
+        event['action'] != action)
+      throw StateError('Print action identity reused with different content');
+    return true;
+  }
+}
diff --git a/apps/operations/test/live/pos02_process_recovery_test.dart b/apps/operations/test/live/pos02_process_recovery_test.dart
new file mode 100644
index 0000000..c098566
--- /dev/null
+++ b/apps/operations/test/live/pos02_process_recovery_test.dart
@@ -0,0 +1,147 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:vynic/core/database/database_core.dart';
+import 'package:vynic/core/database/repositories/print_job_repository.dart';
+import 'package:vynic/core/services/auth/pos_session.dart';
+import 'package:vynic/core/services/printing/print_job.dart';
+import 'package:vynic/core/services/printing/print_reconciliation.dart';
+import '../support/pos02_fixture.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  final path = Platform.environment['POS02_PROCESS_DIRECTORY'];
+  final stage = Platform.environment['POS02_PROCESS_STAGE'];
+  final scenario = Platform.environment['POS02_SCENARIO'];
+  if (path == null || stage == null || scenario == null) {
+    test(
+      'POS02 native proof needs its owned synthetic orchestrator',
+      () {},
+      skip:
+          'python3 tool/prove_pos02_recovery.py --flutter <SDK> --output <proof.json>',
+    );
+    return;
+  }
+  final parent = Directory(path).parent;
+  if (!parent.path
+          .split(Platform.pathSeparator)
+          .last
+          .startsWith('vynic_pos02_process_') ||
+      !parent.absolute.path.startsWith(Directory.systemTemp.absolute.path)) {
+    throw StateError(
+      'POS02 proof accepts only newly owned disposable temp directories',
+    );
+  }
+  test('POS02 $scenario native process $stage', () async {
+    final f = Pos02Fixture();
+    await f.open(path, instrument: stage != 'reader');
+    if (stage == 'boundaries') {
+      await f.prepare(scenario);
+      await f.action(scenario);
+      await File(
+        '$path/boundaries.json',
+      ).writeAsString(jsonEncode({'pid': pid, 'trace': f.trace}), flush: true);
+    } else if (stage == 'writer') {
+      await f.prepare(scenario);
+      final target = int.parse(Platform.environment['POS02_CHECKPOINT']!);
+      f.fault = (point, position) async {
+        if (position != target) return;
+        // Make this completed prefix durable without closing/cleaning Hive.
+        // Process death is proved; arbitrary storage-controller power loss is not.
+        await (DatabaseCore.metaBox! as Pos02Box).inner.flush();
+        await (DatabaseCore.orderBox! as Pos02OrderBox).inner.flush();
+        await DatabaseCore.settingsBox!.flush();
+        await DatabaseCore.auditLogBox!.flush();
+        final jobs = PrintJobRepository.all();
+        await File('$path/ready.tmp').writeAsString(
+          jsonEncode({
+            'pid': pid,
+            'scenario': scenario,
+            'checkpoint': target,
+            'point': point,
+            'acknowledged': f.acknowledged,
+            'jobs': jobs.map((j) => j.toMap()).toList(),
+            'writes': f.persistedWriteCount,
+            'httpBlocked': true,
+            'boxesClosed': false,
+          }),
+          flush: true,
+        );
+        await File('$path/ready.tmp').rename('$path/ready.json');
+        await Completer<void>().future;
+      };
+      await f.action(scenario);
+      fail(
+        'Writer must be killed by its owned orchestrator at the actual boundary',
+      );
+    } else if (stage == 'reader') {
+      final ready =
+          jsonDecode(await File('$path/ready.json').readAsString()) as Map;
+      PosSession.start(
+        DatabaseCore.userBox!.values.singleWhere(
+          (u) => u.username == 'synthetic-operator',
+        ),
+      );
+      PrintReconciliation.policy = PrintReconciliationPolicy.administrators;
+      f.mode = scenario == 'uncertain' ? 'flush-error' : 'sent';
+      final before = PrintJobRepository.all();
+      // sending rows must already have become uncertain at DatabaseCore.open.
+      expect(before.any((j) => j.state == PrintJobState.sending), false);
+      final interrupted = (ready['jobs'] as List).where(
+        (j) => j['attempts'].last['state'] == 'sending',
+      );
+      for (final raw in interrupted) {
+        expect(
+          PrintJobRepository.read(raw['id'])!.state,
+          PrintJobState.uncertain,
+        );
+      }
+      await f.dispatch();
+      await f.action(scenario);
+      final jobs = PrintJobRepository.all();
+      expect(jobs, hasLength(1));
+      final job = jobs.single;
+      expect(
+        job.state,
+        isIn([
+          PrintJobState.sent,
+          PrintJobState.uncertain,
+          PrintJobState.confirmed,
+        ]),
+      );
+      final upper = scenario == 'reprint' ? 2 : 1;
+      expect(f.persistedWriteCount, lessThanOrEqualTo(upper));
+      if (interrupted.isNotEmpty)
+        expect(f.persistedWriteCount, ready['writes']);
+      final stable = job.toMap();
+      final count = f.persistedWriteCount;
+      await PrintJobRepository.recover();
+      await f.action(scenario);
+      await f.dispatch();
+      expect(PrintJobRepository.all().single.toMap(), stable);
+      expect(f.persistedWriteCount, count);
+      expect(pid, isNot(ready['pid']));
+      await File('$path/result.json').writeAsString(
+        jsonEncode({
+          'status': 'PASS',
+          'writerPid': ready['pid'],
+          'readerPid': pid,
+          'state': job.state.name,
+          'jobId': job.id,
+          'attemptIds': job.attempts.map((a) => a['id']).toList(),
+          'writes': count,
+          'sendingRecoveredBeforeReplay': true,
+          'exactRetryAddedNoWrite': true,
+          'noUncertainAutomaticRetry': true,
+          'httpBlocked': true,
+          'syntheticTransportOnly': true,
+        }),
+        flush: true,
+      );
+    } else {
+      throw StateError('Unknown native proof stage');
+    }
+    await f.close();
+  });
+}
