+            onPressed: () => showDialog<void>(
+              context: context,
+              builder: (_) => const PrintJobsDialog(),
+            ),
+            icon: Icon(
+              count > 0 || error != null
+                  ? Icons.print_disabled_outlined
+                  : Icons.print_outlined,
+            ),
+            label: Text(label, textAlign: TextAlign.center),
+          ),
+        ),
+      );
+    },
+  );
