+#!/usr/bin/env python3
+"""SIGKILL/restart every print journal I/O and transport boundary; owned synthetic data only."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import shutil
+import signal
+import subprocess
+import tempfile
+import time
+
+
+def require_descendant(native_pid, runner_pid):
+    current = native_pid
+    for _ in range(20):
+        if current == runner_pid:
+            return
+        value = subprocess.check_output(['ps', '-o', 'ppid=', '-p', str(current)], text=True).strip()
+        if not value or int(value) <= 1:
+            break
+        current = int(value)
+    raise RuntimeError('Refusing to signal a process not created by this proof')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--flutter', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--checkpoint', type=int, help='Optional one boundary for debugging')
+    parser.add_argument('--scenario', choices=['send','uncertain','reprint','confirm','remotecreate','localconfirm'])
+    args = parser.parse_args()
+    project = Path(__file__).resolve().parents[1]
+    output = args.output.resolve()
+    output.parent.mkdir(parents=True, exist_ok=True)
+    root = Path(tempfile.mkdtemp(prefix='vynic_pos02_process_', dir=None))
+    command = [str(args.flutter.resolve()), '--suppress-analytics', 'test', '--no-pub', '--reporter', 'expanded', 'test/live/pos02_process_recovery_test.dart']
