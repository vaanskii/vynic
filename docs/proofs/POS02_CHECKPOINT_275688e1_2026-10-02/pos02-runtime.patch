+              if (job.state != PrintJobState.confirmed)
+                TextButton(
+                  key: ValueKey('print-confirm-${job.id}'),
+                  style: TextButton.styleFrom(minimumSize: const Size(48, 48)),
+                  onPressed: allowed
+                      ? () => _act(context, job, 'confirm')
+                      : null,
+                  child: Text(
+                    _t(context, 'ქაღალდი შევამოწმე', 'Paper checked'),
+                  ),
+                ),
+              OutlinedButton(
+                key: ValueKey('print-reprint-${job.id}'),
+                style: OutlinedButton.styleFrom(
+                  minimumSize: const Size(48, 48),
+                ),
+                onPressed: allowed ? () => _act(context, job, 'reprint') : null,
+                child: Text(_t(context, 'მონიშნული ასლი', 'Labeled copy')),
+              ),
+            ],
+          ),
+        if (job.state == PrintJobState.failed)
+          OutlinedButton(
+            key: ValueKey('print-retry-${job.id}'),
+            style: OutlinedButton.styleFrom(minimumSize: const Size(48, 48)),
+            onPressed: allowed ? () => _act(context, job, 'retry') : null,
+            child: Text(
+              _t(
+                context,
+                'კავშირი აღდგა — ხელახლა გაგზავნა',
+                'Connection restored — retry',
+              ),
+            ),
+          ),
+        if (!allowed && !job.ready && job.state != PrintJobState.sending)
+          Text(
+            _t(
+              context,
+              PrintReconciliation.policy ==
+                      PrintReconciliationPolicy.unconfigured
+                  ? 'შემოწმების უფლების პოლიტიკა ჯერ დასადგენია.'
+                  : 'მიმართეთ უფლებამოსილ ოპერატორს.',
+              PrintReconciliation.policy ==
+                      PrintReconciliationPolicy.unconfigured
+                  ? 'Operator reconciliation policy is not configured.'
+                  : 'Ask an authorized operator.',
+            ),
+          ),
+        ExpansionTile(
+          title: Text(
+            _t(context, 'ისტორია და დეტალები', 'History and details'),
+          ),
+          children: [
+            Align(
+              alignment: Alignment.centerLeft,
+              child: SelectableText(
+                '${job.id}\n${job.host}:${job.port}\n${job.createdAt}',
+              ),
+            ),
+            if (job.detail != null) SelectableText(job.detail!),
+            for (final event in job.audit)
+              Align(
+                alignment: Alignment.centerLeft,
+                child: Text(
+                  '${event['at']} · ${event['action']} ${event['actorId'] ?? ''} ${event['reason'] ?? ''}',
+                ),
+              ),
+          ],
+        ),
+      ],
+    );
+  }
+
+  Future<void> _act(BuildContext context, PrintJob job, String action) =>
+      showDialog<void>(
+        context: context,
+        barrierDismissible: false,
+        builder: (_) => _PrintActionDialog(job: job, action: action),
+      );
+}
+
+Future<String?> requestLabeledPrintCopyReason(BuildContext context) =>
+    showDialog<String>(
+      context: context,
+      barrierDismissible: false,
+      builder: (_) => const _PrintActionDialog(action: 'copy'),
+    );
+
+class _PrintActionDialog extends StatefulWidget {
+  const _PrintActionDialog({this.job, required this.action});
+  final PrintJob? job;
+  final String action;
+  @override
+  State<_PrintActionDialog> createState() => _PrintActionState();
+}
+
+class _PrintActionState extends State<_PrintActionDialog> {
+  final reason = TextEditingController();
+  final requestId = const Uuid().v4();
+  bool busy = false;
+  String? error;
+  @override
+  void dispose() {
+    reason.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => VynicResponsiveDialog(
+    child: Padding(
+      padding: const EdgeInsets.all(20),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          Text(
+            _t(
+              context,
+              widget.action == 'confirm'
+                  ? 'ქაღალდის შემოწმება'
+                  : widget.action == 'retry'
+                  ? 'ხელახლა გაგზავნა'
+                  : 'მონიშნული ასლი',
+              widget.action == 'confirm'
+                  ? 'Confirm paper check'
+                  : widget.action == 'retry'
+                  ? 'Retry delivery'
+                  : 'Labeled reprint',
+            ),
+            style: Theme.of(context).textTheme.titleLarge,
+          ),
+          const SizedBox(height: 12),
+          Text(
+            _t(
+              context,
+              (widget.action == 'reprint' || widget.action == 'copy')
+                  ? 'შეამოწმეთ, ხომ არ დაიბეჭდა პირველი ჩეკი. ახალი ასლი მონიშნული იქნება REPRINT-ით; ნუ მოამზადებთ კერძს ორჯერ.'
+                  : widget.action == 'confirm'
+                  ? 'დაადასტურეთ მხოლოდ ქაღალდისა და ჩეკის ნომრის შემოწმების შემდეგ.'
+                  : 'წინა მცდელობას მონაცემები არ გაუგზავნია. შეამოწმეთ კავშირი და იგივე ჩეკი გაგზავნეთ.',
+              (widget.action == 'reprint' || widget.action == 'copy')
+                  ? 'Check whether the original printed. The new copy is labeled REPRINT; avoid preparing the meal twice.'
+                  : widget.action == 'confirm'
+                  ? 'Confirm only after checking the paper and ticket number.'
+                  : 'The previous attempt wrote no bytes. Check the connection before retrying the same ticket.',
+            ),
+          ),
+          if (!PrintReconciliation.allowed)
+            Text(
+              _t(
+                context,
+                'შემოწმების უფლების პოლიტიკა ჯერ დასადგენია ან მიმართეთ უფლებამოსილ ოპერატორს.',
+                'Reconciliation policy must be configured; ask an authorized operator.',
+              ),
+            ),
+          const SizedBox(height: 16),
+          PosOnScreenTextField(
+            controller: reason,
+            maxLines: 3,
+            enabled: !busy,
+            decoration: InputDecoration(
+              labelText: _t(
+                context,
+                'მიზეზი / შემოწმების შედეგი',
+                'Reason / check result',
+              ),
+              border: const OutlineInputBorder(),
+            ),
+          ),
+          if (error != null)
+            Padding(
+              padding: const EdgeInsets.only(top: 8),
+              child: Text(error!, style: TextStyle(color: VynicColors.danger)),
+            ),
+          const SizedBox(height: 16),
+          Wrap(
+            alignment: WrapAlignment.end,
+            spacing: 12,
+            runSpacing: 8,
+            children: [
+              TextButton(
+                onPressed: busy ? null : () => Navigator.pop(context),
+                child: Text(_t(context, 'გაუქმება', 'Cancel')),
+              ),
+              FilledButton(
+                key: const ValueKey('print-action-submit'),
+                onPressed: busy || !PrintReconciliation.allowed
+                    ? null
+                    : _submit,
+                child: Text(
+                  _t(
+                    context,
+                    busy ? 'ინახება...' : 'დადასტურება',
+                    busy ? 'Saving...' : 'Confirm',
+                  ),
+                ),
+              ),
+            ],
+          ),
+        ],
+      ),
+    ),
+  );
+
+  Future<void> _submit() async {
+    if (busy) return;
+    if (reason.text.trim().length < 3 || reason.text.length > 500) {
+      setState(
+        () => error = _t(
+          context,
+          'მიუთითეთ მიზეზი (3–500 სიმბოლო)',
+          'Enter a reason (3–500 characters)',
+        ),
+      );
+      return;
+    }
+    setState(() {
+      busy = true;
+      error = null;
+    });
+    try {
+      if (widget.action == 'copy') {
+        PrintReconciliation.authorizeCopy(reason.text);
+        if (mounted) Navigator.pop(context, reason.text.trim());
+        return;
+      }
+      if (widget.action == 'confirm')
+        await PrintReconciliation.confirm(widget.job!, reason.text, requestId);
+      else if (widget.action == 'retry')
+        await PrintReconciliation.retryNotSent(
+          widget.job!,
+          reason.text,
+          requestId,
+        );
+      else
+        await PrintReconciliation.reprint(widget.job!, reason.text, requestId);
+      if (mounted) Navigator.pop(context);
+    } catch (e, stack) {
+      developer.log('Print reconciliation failed', error: e, stackTrace: stack);
+      if (mounted)
+        setState(() {
+          busy = false;
+          error = _t(
+            context,
+            'ქმედება ვერ დასრულდა — განაახლეთ ბეჭდვის სია.',
+            'Action failed — refresh the print jobs list.',
+          );
+        });
+    }
+  }
+}
diff --git a/apps/operations/lib/core/database/repositories/print_job_repository.dart b/apps/operations/lib/core/database/repositories/print_job_repository.dart
new file mode 100644
index 0000000..1850fe8
--- /dev/null
+++ b/apps/operations/lib/core/database/repositories/print_job_repository.dart
@@ -0,0 +1,211 @@
+import 'package:flutter/foundation.dart';
+import 'package:vynic/core/database/database_core.dart';
+import 'package:vynic/core/database/local_data_admission.dart';
+import 'package:vynic/core/services/printing/print_job.dart';
+import 'package:vynic/core/services/edge/edge_device_credential_store.dart';
+
+/// Additive v1 rows in the existing format-2 `meta` store (Hive remains v9).
+/// Each job includes all attempts and their audit, so reprint admission is one
+/// flushed row, rather than two independently committed parent/child rows.
+class PrintJobRepository {
+  PrintJobRepository._();
+  static const prefix = 'print_job:v1:';
+  static final changes = ValueNotifier<int>(0);
+  static String? failure;
+  static String key(String id) => '$prefix$id';
+
+  static PrintJob decode(dynamic key, dynamic value) {
+    final job = PrintJob.decode(value);
+    if (key != PrintJobRepository.key(job.id))
+      throw const FormatException('Print job key/identity disagrees');
+    return job;
+  }
+
+  static List<PrintJob> all() {
+    final box = DatabaseCore.metaBox;
+    if (box == null || !box.isOpen) return const [];
+    final jobs = <PrintJob>[];
+    for (final k in box.keys) {
+      if (k is! String || !k.startsWith('print_job:')) continue;
+      if (!k.startsWith(prefix))
+        throw const FormatException('Unknown print job protocol');
+      jobs.add(decode(k, box.get(k)));
+    }
+    jobs.sort((a, b) {
+      final time = a.createdAt.compareTo(b.createdAt);
+      return time == 0 ? a.id.compareTo(b.id) : time;
+    });
+    return jobs;
+  }
+
+  static PrintJob? read(String id) {
+    final raw = DatabaseCore.metaBox?.get(key(id));
+    return raw == null ? null : decode(key(id), raw);
+  }
+
+  static Future<void> _save(PrintJob job) async {
+    final box = DatabaseCore.metaBox;
+    if (box == null || !box.isOpen)
+      throw StateError('Print persistence is unavailable');
+    try {
+      await box.put(key(job.id), job.toMap());
+      await box.flush();
+      changes.value++;
+    } catch (error) {
+      failure = 'Print job persistence failed: $error';
+      changes.value++;
+      rethrow;
+    }
+  }
+
+  static Future<PrintJob> enqueue(
+    PrintJob job,
+  ) => LocalDataAdmission.mutate(() async {
+    if (failure != null) throw StateError(failure!);
+    final existing = read(job.id);
+    if (existing != null) {
+      final a = existing.toMap(), b = job.toMap();
+      for (final field in [
+        'target',
+        'host',
+        'port',
+        'label',
+        'venueId',
+        'payloadSha256',
+        'copyOf',
+        'requiresConfirmedOrderUuid',
+      ]) {
+        if (a[field] != b[field])
+          throw StateError('Print job identity reused with different content');
+      }
+      final oldAdmission = existing.audit.first, newAdmission = job.audit.first;
+      for (final field in ['actorId', 'reason']) {
+        if (oldAdmission[field] != newAdmission[field]) {
+          throw StateError(
+            'Print copy identity reused with different operator evidence',
+          );
+        }
+      }
+      return existing;
+    }
+    await _save(job);
+    return job;
+  });
+
+  static Future<PrintJob> transition(
+    String id,
+    String attemptId,
+    PrintJobState expected,
+    PrintJobState state, {
+    String? detail,
+    String? actorId,
+    String? reason,
+    String? actionId,
+  }) => LocalDataAdmission.mutate(() async {
+    final job = read(id);
+    if (job == null || job.attemptId != attemptId || job.state != expected)
+      throw StateError('Print attempt changed; refresh before acting');
+    final body = job.toMap();
+    final now = DateTime.now().toUtc().toIso8601String();
+    (body['attempts'] as List).last['state'] = state.name;
+    if (detail != null) (body['attempts'] as List).last['detail'] = detail;
+    (body['audit'] as List).add({
+      'action': state.name,
+      'at': now,
+      'attemptId': attemptId,
+      if (detail != null) 'detail': detail,
+      if (actorId != null) 'actorId': actorId,
+      if (reason != null) 'reason': reason,
+      if (actionId != null) 'actionId': actionId,
+    });
+    final next = PrintJob.decode(body);
+    await _save(next);
+    return next;
+  });
+
+  static Future<PrintJob> reprint(
+    String id,
+    String expectedAttemptId,
+    String requestId,
+    String actorId,
+    String reason,
+  ) => LocalDataAdmission.mutate(() async {
+    final job = read(id);
+    if (job == null) throw StateError('Print job not found');
+    final previous = job.attempts.where((a) => a['id'] == requestId);
+    if (previous.isNotEmpty) {
+      final a = previous.single;
+      if (a['actorId'] != actorId || a['reason'] != reason)
+        throw StateError(
+          'Reprint identity reused with different operator/reason',
+        );
+      return job;
+    }
+    if (job.attemptId != expectedAttemptId ||
+        job.ready ||
+        job.state == PrintJobState.sending ||
+        job.state == PrintJobState.failed)
+      throw StateError(
+        'Print attempt changed or has not been sent; refresh before reprinting',
+      );
+    final body = job.toMap();
+    final now = DateTime.now().toUtc().toIso8601String();
+    (body['attempts'] as List).add({
+      'id': requestId,
+      'state': 'reprint',
+      'queuedAt': now,
+      'actorId': actorId,
+      'reason': reason,
+    });
+    (body['audit'] as List).add({
+      'action': 'reprint',
+      'at': now,
+      'attemptId': requestId,
+      'actorId': actorId,
+      'reason': reason,
+    });
+    final next = PrintJob.decode(body);
+    await _save(next);
+    return next;
+  });
+
+  /// Startup/restore never resends an attempt that crossed the send boundary.
+  /// Portable queued jobs are held too: their source may still be operating.
+  static Future<void> recover({
+    bool restored = false,
+    bool underExclusive = false,
+  }) async {
+    Future<void> run() async {
+      failure = null;
+      final jobs = all(); // Validate every row before changing anything.
+      for (final job in jobs) {
+        final foreign = job.venueId != EdgeDeviceCredentialStore.venueId;
+        if (job.state == PrintJobState.sending ||
+            (restored || foreign) && job.ready) {
+          await transition(
+            job.id,
+            job.attemptId,
+            job.state,
+            PrintJobState.uncertain,
+            detail: restored
+                ? 'Restored from backup; check the source terminal and paper before reprinting'
+                : foreign
+                ? 'Venue binding is unavailable or different; automatic delivery held'
+                : 'Process stopped during transmission; paper outcome is unknown',
+          );
+        }
+      }
+      changes.value++;
+    }
+
+    if (underExclusive) {
+      await run();
+    } else {
+      await LocalDataAdmission.exclusive(
+        run,
+        recovery: true,
+        operation: 'print recovery',
+      );
+    }
+  }
+}
