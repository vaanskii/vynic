+    'venueId': venueId,
+    'terminalId': terminalId,
+    'epoch': '$epoch',
+    'grantFingerprint': grantFingerprint,
+    'mode': mode,
+  };
+  factory ProofBinding.fromFrame(dynamic raw) {
+    final b = proofMap(raw, {
