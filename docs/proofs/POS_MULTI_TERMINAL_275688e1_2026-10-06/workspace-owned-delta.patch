+export type PrinterRuntimeRole = 'kitchen' | 'bar' | 'receipt' | 'additional';
+export type PrinterCommandLanguage = 'escposRaster' | 'windowsDriverRendered';
+export type PrinterBeepCapability =
+  | 'unknown'
+  | 'unsupported'
