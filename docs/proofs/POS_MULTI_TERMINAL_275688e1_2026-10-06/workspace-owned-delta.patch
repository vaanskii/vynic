+function conflictOutcome(error: PrinterRuntimeConfigError): PersistedOutcome {
+  return {
+    status: 409,
+    json: canonicalJson({
+      statusCode: 409,
+      error: 'Conflict',
+      code: error.code,
+      message: error.message,
+    }),
+  };
