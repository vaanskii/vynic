+export type PrinterCapabilityProfile = Readonly<{
+  protocol: 1;
+  paperWidthMm: number;
+  rasterWidthDots: number;
+  language: PrinterCommandLanguage;
+  cutter: 'none' | 'full' | 'partial';
+  encoding: 'georgianViaRaster';
