+        {'protocol': 2},
+        {'paperWidthMm': 39},
+        {'paperWidthMm': 121},
+        {'paperWidthMm': '80'},
+        {'rasterWidthDots': 63},
+        {'rasterWidthDots': 65},
+        {'rasterWidthDots': 2056},
+        {'rasterWidthDots': 576.0},
+        {'language': 'arbitraryRaw'},
+        {'cutter': 'drawerPulse'},
+        {'encoding': 'assumeGeorgianCodePage'},
+        {'transport': 'tcp'},
