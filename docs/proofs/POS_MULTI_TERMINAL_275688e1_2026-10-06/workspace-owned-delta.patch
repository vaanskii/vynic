+          error = failure is PrinterRouteRevisionConflict
+              ? 'მარშრუტი შეიცვალა. დახურეთ ფანჯარა და ხელახლა გახსენით.'
+              : 'მარშრუტის შენახვა ვერ მოხერხდა: $failure';
+        });
+      }
+    }
+  }
