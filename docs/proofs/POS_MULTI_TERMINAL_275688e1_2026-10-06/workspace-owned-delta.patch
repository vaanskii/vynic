+    ];
+    final report = AuditReport(
+      reportId: reportKey,
+      orderId: number,
+      tableNumbers: tables,
+      floor: order.floor,
+      openedById: context.actorId,
+      openedByName: context.actorId,
+      openedAt: context.occurredAt,
+      status: AuditReportStatus.open,
+      locked: false,
+      updatedAt: context.occurredAt,
+      events: [
