+      'protocol': body['protocol'],
+      'id': body['id'],
+      'name': body['name'],
+      'role': body['role'],
+      'revision': body['revision'],
+      'destination': PrinterDestination.decode(rawDestination).toMap(),
+      'capabilityProfile': _profile(body['capabilityProfile']).toMap(),
+    });
