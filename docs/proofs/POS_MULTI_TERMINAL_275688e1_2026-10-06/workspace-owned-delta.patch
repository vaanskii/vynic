+    version: 2,
+    deviceId: context.deviceId,
+    venueId: context.venueId,
+    revision: revision + 1,
+    phase: 'PREPARED',
+    minimumReaderVersion: 2,
+    printers: legacyDisabledPrinters(),
+    routes,
+  });
