+  final int sequence;
+  final String requestId, terminalId, fingerprint;
+  Map<String, dynamic> toFrame() => {
+    'sequence': '$sequence',
+    'requestId': requestId,
+    'terminalId': terminalId,
+    'fingerprint': fingerprint,
+  };
+  factory _EventReceipt.fromFrame(dynamic raw) {
+    final b = proofMap(raw, {
+      'sequence',
+      'requestId',
+      'terminalId',
