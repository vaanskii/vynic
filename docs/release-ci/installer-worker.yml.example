# INACTIVE TEMPLATE. Do not move into .github/workflows until access, protected
# environment reviewers, action SHAs, DNS route and end-to-end release gates pass.
name: Qualified installer Worker deployment
on:
  workflow_dispatch:
    inputs:
      approved_sha:
        description: Reviewed full main commit (must equal this workflow run SHA)
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: installer-worker-production
  cancel-in-progress: false
jobs:
  deploy:
    if: github.repository == 'vaanskii/vynic' && github.ref == 'refs/heads/main' && vars.SAFE_WORKER_DEPLOY_ENABLED == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment: installer-worker-production
    defaults:
      run:
        working-directory: apps/installer-worker
        shell: bash
    steps:
      - uses: actions/checkout@REPLACE_WITH_REVIEWED_COMMIT_SHA
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: actions/setup-node@REPLACE_WITH_REVIEWED_COMMIT_SHA
        with:
          node-version: '22'
      - name: Require the exact approved source
        env:
          APPROVED_SHA: ${{ inputs.approved_sha }}
        run: |
          set -euo pipefail
          [[ "$APPROVED_SHA" =~ ^[0-9a-f]{40}$ ]]
          [[ "$APPROVED_SHA" == "$GITHUB_SHA" ]]
          [[ "$(git rev-parse HEAD)" == "$APPROVED_SHA" ]]
      - run: npm ci
      - run: npm run check
      - name: Upload only a Worker version (does not change routes or activate traffic)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_INSTALLER_WORKER_DEPLOY_TOKEN }}
          WRANGLER_OUTPUT_FILE_PATH: ${{ runner.temp }}/installer-worker-version-${{ github.run_id }}-${{ github.run_attempt }}.jsonl
          WRANGLER_SEND_METRICS: 'false'
        run: |
          set -euo pipefail
          test -n "$CLOUDFLARE_API_TOKEN"
          test ! -e "$WRANGLER_OUTPUT_FILE_PATH"
          ./node_modules/.bin/wrangler versions upload --strict --keep-vars --tag "$GITHUB_SHA" --message "Reviewed source $GITHUB_SHA"
      - name: Activate only the exact uploaded version
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_INSTALLER_WORKER_DEPLOY_TOKEN }}
          WRANGLER_OUTPUT_FILE_PATH: ${{ runner.temp }}/installer-worker-version-${{ github.run_id }}-${{ github.run_attempt }}.jsonl
          WRANGLER_SEND_METRICS: 'false'
        run: |
          set -euo pipefail
          version_id=$(node tool/read-upload-version.mjs "$WRANGLER_OUTPUT_FILE_PATH")
          ./node_modules/.bin/wrangler versions deploy "$version_id@100%" --yes --message "Reviewed source $GITHUB_SHA"
# No triggers deploy, DNS API, bucket credentials, secret creation, push events,
# pull_request_target, source-writing permissions or automatic credential renewal.
# A successful workflow is deployment evidence, not customer installer acceptance.
