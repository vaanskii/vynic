# Prisma connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vynic?schema=public"

# JWT signing secret used by auth module
JWT_SECRET=change-me-jwt-secret

# Must match POS_SYNC_API_KEY in pos_app_client/.env
POS_SYNC_API_KEY=change-me-sync-key

# Optional: public URL for this backend in deployment
# BACKEND_PUBLIC_URL=https://api.your-domain.com

# Required for backend FCM push sending (Firebase Admin SDK credential file path)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json
