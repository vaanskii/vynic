# PostgreSQL — one database, Prisma manages `pos` + `website` schemas
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vynic"

# ── POS / manager mobile ──────────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret
POS_SYNC_API_KEY=change-me-sync-key
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/firebase-adminsdk.json"

# ── Website (public reservations + customer auth) ─────────────────────────────
JWT_REFRESH_SECRET=change-me-refresh-secret
COOKIE_ENCRYPTION_KEY=change-me-32-char-cookie-key!!!
FRONTEND_URL=http://localhost:5173
API_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=

# Website SUPER_ADMIN — auto-created on server start when both are set
WEBSITE_ADMIN_PHONE=+995500000000
WEBSITE_ADMIN_EMAIL=admin@example.com
WEBSITE_ADMIN_PASSWORD=change-me-admin
# Legacy aliases from old server/.env also work:
# SUPER_ADMIN_PHONE= SUPER_ADMIN_EMAIL= SUPER_ADMIN_PASSWORD=

# Bank of Georgia payment gateway
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=

# Server
PORT=3000
NODE_ENV=development
