generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["pos", "website"]
}

// ─── POS schema (synced from Windows POS + manager mobile) ───────────────────

model Table {
  id            String   @id @default(uuid())
  tableNumber   String
  floor         String
  isReserved    Boolean  @default(false)
  activeOrderId Int?
  currentBill   Float    @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([tableNumber, floor], name: "tableIdentifier")
  @@schema("pos")
}

model Order {
  id                String      @id @default(uuid())
  posOrderId        Int         @unique
  status            String
  totalAmount       Float
  guestCount        Int         @default(0)
  waiterName        String
  floor             String      @default("")
  businessDate      String      @default("")
  customerName      String      @default("")
  customerPhone     String      @default("")
  pickupTime        String      @default("")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  paymentType       String      @default("cash")
  discountAmount    Float       @default(0)
  includeServiceFee Boolean     @default(false)
  serviceFeePercent Float       @default(10)
  items             OrderItem[]

  @@schema("pos")
}

model OrderItem {
  id       String @id @default(uuid())
  orderId  String
  name     String
  quantity Int
  price    Float
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@schema("pos")
}

model MenuCategory {
  id            String            @id @default(uuid())
  slug          String            @unique
  nameKa        String
  nameEn        String
  sendToKitchen Boolean           @default(true)
  sortOrder     Int               @default(0)
  updatedAt     DateTime          @updatedAt
  items         MenuItem[]
  subcategories MenuSubcategory[]

  @@schema("pos")
}

model MenuSubcategory {
  id         String       @id @default(uuid())
  slug       String
  nameKa     String
  nameEn     String
  categoryId String
  sortOrder  Int          @default(0)
  updatedAt  DateTime     @updatedAt
  items      MenuItem[]
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([slug, categoryId])
  @@schema("pos")
}

model MenuItem {
  id            String            @id @default(uuid())
  categoryId    String?
  nameKa        String
  nameEn        String
  price         Float
  sendToKitchen Boolean           @default(true)
  sortOrder     Int               @default(0)
  updatedAt     DateTime          @updatedAt
  subcategoryId String?
  category      MenuCategory?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory   MenuSubcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  variants      MenuItemVariant[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@schema("pos")
}

model MenuItemVariant {
  id         String   @id @default(uuid())
  menuItemId String
  size       Float
  price      Float
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@schema("pos")
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Float
  category    String
  createdAt   DateTime @default(now())
  paymentType String   @default("cash")

  @@schema("pos")
}

model Staff {
  id        String    @id @default(uuid())
  username  String    @unique
  pinHash   String
  role      StaffRole @default(WAITER)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@schema("pos")
}

model AuditReport {
  id           String       @id @default(uuid())
  reportId     String       @unique
  posOrderId   Int
  tableNumbers String[]
  floor        String       @default("first")
  openedById   String
  openedByName String
  openedAt     DateTime
  status       String
  closedAt     DateTime?
  closedById   String?
  closedByName String?
  locked       Boolean      @default(false)
  updatedAt    DateTime     @updatedAt
  events       AuditEvent[]

  @@index([posOrderId])
  @@index([status])
  @@schema("pos")
}

model AuditEvent {
  id          String      @id @default(uuid())
  reportId    String
  type        String
  itemName    String
  previousQty Int
  newQty      Int
  waiterId    String
  waiterName  String
  eventTime   DateTime
  note        String?
  seq         Int         @default(0)
  report      AuditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@schema("pos")
}

model AuditEventLog {
  id         String   @id @default(uuid())
  action     String
  userId     String
  data       Json
  deviceType String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@schema("pos")
}

model DailySnapshot {
  id            String   @id @default(uuid())
  date          String   @unique
  totalRevenue  Float    @default(0)
  orderCount    Int      @default(0)
  avgOrderValue Float    @default(0)
  cashRevenue   Float    @default(0)
  cardRevenue   Float    @default(0)
  totalExpenses Float    @default(0)
  topItemsJson  String   @default("[]")
  updatedAt     DateTime @updatedAt

  @@schema("pos")
}

model QuickOrderDraft {
  id                String                @id @default(uuid())
  draftId           String                @unique
  displayName       String?
  subtotal          Float
  serviceFeeAmount  Float
  total             Float
  includeServiceFee Boolean               @default(false)
  serviceFeeRate    Float                 @default(0.1)
  createdAt         DateTime              @default(now())
  createdBy         String
  updatedAt         DateTime              @updatedAt
  items             QuickOrderDraftItem[]

  @@schema("pos")
}

model QuickOrderDraftItem {
  id       String          @id @default(uuid())
  draftId  String
  name     String
  quantity Int
  price    Float
  comment  String?
  draft    QuickOrderDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@schema("pos")
}

enum StaffRole {
  MANAGER
  SUPERVISOR
  WAITER
  ADMIN

  @@schema("pos")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@schema("pos")
}

model ManagerNotification {
  id        String   @id @default(uuid())
  wsType    String
  title     String
  body      String
  envelope  Json
  createdAt DateTime @default(now())

  deliveries ManagerNotificationDelivery[]

  @@schema("pos")
}

model ManagerNotificationDelivery {
  id             String   @id @default(uuid())
  notificationId String
  staffUsername  String
  channel        String
  createdAt      DateTime @default(now())

  notification ManagerNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, staffUsername])
  @@index([staffUsername])
  @@schema("pos")
}

model PushDevice {
  id            String   @id @default(uuid())
  staffUsername String
  fcmToken      String   @unique
  platform      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([staffUsername])
  @@schema("pos")
}

model PosCallbackOutbox {
  id            String   @id @default(uuid())
  endpoint      String
  payload       Json
  posOrderId    Int?
  dedupeKey     String?
  status        String   @default("pending")
  attempts      Int      @default(0)
  maxAttempts   Int      @default(20)
  lastError     String?
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([posOrderId])
  @@index([dedupeKey])
  @@schema("pos")
}

// ─── Website schema (public bookings + customer accounts) ────────────────────

enum WebsiteUserRole {
  USER
  SUPER_ADMIN

  @@schema("website")
}

enum WebsiteReservationStatus {
  PENDING
  CONFIRMED
  FAILED
  COMPLETED

  @@schema("website")
}

model WebsiteUser {
  id        String          @id @default(uuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  email     String?         @unique
  password  String
  firstName String?
  lastName  String?
  phone     String          @unique
  role      WebsiteUserRole @default(USER)

  hashedRefreshToken String?
  reservations       WebsiteReservation[]

  @@schema("website")
  @@map("users")
}

/// Bookable tables shown on the public website. Each row maps to a POS table.
model WebsiteTable {
  id                 Int      @id @default(autoincrement())
  websiteTableNumber String   @unique
  posTableNumber     String
  posFloor           String
  capacity           Int      @default(4)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reservations WebsiteReservationTable[]

  @@schema("website")
  @@map("tables")
}

model WebsiteReservation {
  id            String                   @id @default(uuid())
  userId        String?
  customerName  String?
  customerEmail String?
  customerPhone String?
  date          DateTime
  timeSlot      String
  status        WebsiteReservationStatus @default(PENDING)
  totalAmount   Float?
  menuItems     String?
  paymentId     String?
  paymentStatus String?
  notes         String?
  posReservationId String? @unique
  numberOfGuests   Int?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  user   WebsiteUser?              @relation(fields: [userId], references: [id])
  tables WebsiteReservationTable[]

  @@schema("website")
  @@map("reservations")
}

model WebsiteReservationTable {
  id            Int      @id @default(autoincrement())
  reservationId String
  tableId       Int
  createdAt     DateTime @default(now())

  reservation WebsiteReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table       WebsiteTable       @relation(fields: [tableId], references: [id])

  @@unique([reservationId, tableId])
  @@schema("website")
  @@map("reservation_tables")
}
