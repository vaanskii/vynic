# API base URL (optional — defaults to same origin in production)
# VITE_API_URL=https://api.example.com

# Coming-soon mode: home page only + construction modal.
# - Omitted locally: disabled in dev
# - Production build: enabled by default
# - Set to false when ready to launch publicly
# VITE_COMING_SOON=false

# Force coming-soon locally for testing:
# VITE_COMING_SOON=true
