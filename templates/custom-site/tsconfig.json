{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "@testing-library/jest-dom"],
    "paths": {
      "@vynic/website-client": ["../../packages/website-client/src/index.ts"]
    }
  },
  "include": ["src", "../../packages/website-client/src"],
  "exclude": ["../../packages/website-client/src/**/*.test.ts"]
}
